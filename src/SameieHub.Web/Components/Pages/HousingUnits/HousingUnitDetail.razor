@page "/boenheter/{Id:int}"
@using SameieHub.Web.Components.Pages.BoardCases
@using SameieHub.Web.Components.Pages.TaskItems
@inject HousingUnitService HousingUnitService
@inject BoardCaseService BoardCaseService
@inject TaskItemService TaskService
@inject NavigationManager Navigation
@inject ILogger<HousingUnitDetail> Logger

<PageTitle>@(_unit?.Address ?? "Boenhet") – SameieHub</PageTitle>

@if (_isLoading)
{
    <PageHeader Title="Boenhet" BackHref="/boenheter" BackText="Boenheter" />
    <div class="surface-card" role="status">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Laster boenhet …
    </div>
}
else if (_loadError != null)
{
    <PageHeader Title="Boenhet" BackHref="/boenheter" BackText="Boenheter" />
    <div class="alert alert-danger" role="alert">
        <p>@_loadError</p>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Prøv igjen</button>
    </div>
}
else if (_unit == null)
{
    <PageHeader Title="Boenhet" BackHref="/boenheter" BackText="Boenheter" />
    <div class="surface-card empty-state">
        <h2>Fant ikke boenheten</h2>
        <p>Boenheten finnes ikke, eller den er fjernet.</p>
        <a class="btn btn-primary" href="/boenheter">Tilbake til boenheter</a>
    </div>
}
else
{
    <PageHeader Title="@_unit.Address" BackHref="/boenheter" BackText="Boenheter">
        <a class="btn btn-primary" href="/boenheter/@_unit.Id/rediger">Rediger</a>
        @if (_unit.IsActive)
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@_isChangingStatus" @onclick="DeactivateAsync">Deaktiver</button>
        }
        else
        {
            <button type="button" class="btn btn-outline-secondary" disabled="@_isChangingStatus" @onclick="ActivateAsync">Reaktiver</button>
        }
    </PageHeader>

    @if (_message != null)
    {
        <div class="alert alert-success" role="status">@_message</div>
    }
    @if (_errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <div class="detail-meta">
        <HousingUnitStatusBadge IsActive="_unit.IsActive" />
        <span class="text-muted">ID @_unit.Id</span>
        @if (!_unit.IsActive)
        {
            <span class="text-muted">Inaktive boenheter beholdes i registeret og kan reaktiveres.</span>
        }
    </div>

    <div class="detail-grid">
        <section class="surface-card">
            <h2>Boliginformasjon</h2>
            <dl class="detail-list">
                <DetailItem Label="Adresse" Value="@_unit.Address" />
                <DetailItem Label="Bolignummer" Value="@_unit.UnitNumber" />
                <DetailItem Label="Seksjonsnummer" Value="@_unit.SectionNumber?.ToString()" />
                <DetailItem Label="Boligtype" Value="@(_unit.HousingType is { } type ? HousingTypeText.ToNorwegian(type) : null)" />
                <DetailItem Label="Areal" Value="@(_unit.AreaSquareMeters is { } area ? $"{area:0.##} m²" : null)" />
            </dl>
        </section>

        <section class="surface-card">
            <h2>Eier og kontaktinformasjon</h2>
            @if (HasSecondOwner)
            {
                <h3 class="owner-title">Eier 1</h3>
            }
            <dl class="detail-list">
                <DetailItem Label="Navn" Value="@_unit.OwnerName" />
                <DetailItem Label="Telefon" Value="@_unit.OwnerPhoneNumber" LinkPrefix="tel:" />
                <DetailItem Label="E-post" Value="@_unit.OwnerEmail" LinkPrefix="mailto:" />
            </dl>
            @if (HasSecondOwner)
            {
                <h3 class="owner-title">Eier 2</h3>
                <dl class="detail-list">
                    <DetailItem Label="Navn" Value="@_unit.SecondOwnerName" />
                    <DetailItem Label="Telefon" Value="@_unit.SecondOwnerPhoneNumber" LinkPrefix="tel:" />
                    <DetailItem Label="E-post" Value="@_unit.SecondOwnerEmail" LinkPrefix="mailto:" />
                </dl>
            }
        </section>

        <section class="surface-card detail-wide">
            <h2>Merknader</h2>
            @if (string.IsNullOrWhiteSpace(_unit.Notes))
            {
                <p class="text-muted mb-0">Ikke registrert</p>
            }
            else
            {
                <p class="notes-text mb-0">@_unit.Notes</p>
            }
        </section>

        <section class="surface-card detail-wide">
            <div class="section-heading">
                <h2>Styresaker</h2>
                @if (_unit.IsActive)
                {
                    <a class="btn btn-outline-primary btn-sm" href="/styresaker/ny?boenhet=@_unit.Id">Registrer styresak</a>
                }
            </div>
            @if (_linkedCases.Count == 0)
            {
                <p class="text-muted mb-0">Ingen styresaker er knyttet til denne boenheten.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table data-table">
                        <caption class="visually-hidden">Styresaker knyttet til boenheten</caption>
                        <thead>
                            <tr>
                                <th scope="col" class="col-id">Sak</th>
                                <th scope="col">Tittel</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var boardCase in _linkedCases)
                            {
                                <tr>
                                    <td class="col-id">#@boardCase.Id</td>
                                    <td><a class="unit-link" href="/styresaker/@boardCase.Id">@boardCase.Title</a></td>
                                    <td><BoardCaseStatusBadge Status="boardCase.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <section class="surface-card detail-wide">
            <div class="section-heading">
                <h2>Oppgaver</h2>
                @if (_unit.IsActive)
                {
                    <a class="btn btn-outline-primary btn-sm" href="/oppgaver/ny?boenhet=@_unit.Id">Registrer oppgave</a>
                }
            </div>
            @if (_linkedTasks.Count == 0)
            {
                <p class="text-muted mb-0">Ingen oppgaver er knyttet til denne boenheten.</p>
            }
            else
            {
                var today = TaskService.GetToday();

                <div class="table-responsive">
                    <table class="table data-table">
                        <caption class="visually-hidden">Oppgaver knyttet til boenheten</caption>
                        <thead>
                            <tr>
                                <th scope="col" class="col-id">Nr.</th>
                                <th scope="col">Oppgave</th>
                                <th scope="col">Status</th>
                                <th scope="col">Frist</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in _linkedTasks)
                            {
                                <tr>
                                    <td class="col-id">#@task.Id</td>
                                    <td><a class="unit-link" href="/oppgaver/@task.Id">@task.Title</a></td>
                                    <td><TaskStatusBadge Status="task.Status" /></td>
                                    <td><TaskDueDate Task="task" Today="today" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>

    <section class="surface-card danger-zone">
        @if (_deleteError != null)
        {
            <div class="alert alert-danger" role="alert">@_deleteError</div>
        }

        @if (!_confirmingDelete)
        {
            <div class="danger-zone-row">
                <div>
                    <h2>Slett boenhet</h2>
                    <p class="text-muted mb-0">Fjerner boenheten og alle opplysninger permanent. Bruk Deaktiver hvis du bare vil skjule den.</p>
                </div>
                <button type="button" class="btn btn-outline-danger" @onclick="AskForDeleteConfirmation">Slett boenheten …</button>
            </div>
        }
        else
        {
            <div role="alertdialog" aria-labelledby="delete-title" aria-describedby="delete-text">
                <h2 id="delete-title">Slette «@_unit.Address» permanent?</h2>
                <p id="delete-text">
                    <strong>Dette kan ikke angres.</strong> Boenheten og alle opplysninger om den, også eier- og kontaktinformasjon,
                    blir slettet for alltid. Boenheter som er knyttet til styresaker eller oppgaver kan ikke slettes.
                </p>
                <div class="form-actions">
                    <button type="button" class="btn btn-danger" disabled="@_isDeleting" @onclick="DeleteAsync">
                        @(_isDeleting ? "Sletter …" : "Ja, slett permanent")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@_isDeleting" @onclick="CancelDelete">Avbryt</button>
                </div>
            </div>
        }
    </section>
}

@code {
    private HousingUnit? _unit;
    private IReadOnlyList<BoardCase> _linkedCases = [];
    private IReadOnlyList<TaskItem> _linkedTasks = [];
    private bool _isLoading = true;
    private bool _isChangingStatus;
    private bool _confirmingDelete;
    private bool _isDeleting;
    private string? _deleteError;
    private string? _loadError;
    private string? _message;
    private string? _errorMessage;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private bool HasSecondOwner =>
        _unit != null
        && (_unit.SecondOwnerName != null || _unit.SecondOwnerPhoneNumber != null || _unit.SecondOwnerEmail != null);

    protected override async Task OnParametersSetAsync()
    {
        _message = Status switch
        {
            "opprettet" => "Boenheten er registrert.",
            "endret" => "Endringene er lagret.",
            _ => null
        };

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            _unit = await HousingUnitService.GetByIdAsync(Id);

            var allCases = await BoardCaseService.GetAllAsync();
            _linkedCases = BoardCaseSorting.Sort(allCases.Where(boardCase => boardCase.HousingUnitId == Id), BoardCaseSortOrder.Newest);

            var allTasks = await TaskService.GetAllAsync();
            _linkedTasks = TaskItemSorting.Sort(allTasks.Where(task => task.HousingUnitId == Id), TaskItemSortOrder.DueDate);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load housing unit {Id}.", Id);
            _loadError = "Kunne ikke hente boenheten. Kontroller at databasen er tilgjengelig og prøv igjen.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeactivateAsync()
    {
        await ChangeStatusAsync(() => HousingUnitService.DeactivateAsync(Id), "Boenheten er deaktivert.");
    }

    private async Task ActivateAsync()
    {
        await ChangeStatusAsync(() => HousingUnitService.ActivateAsync(Id), "Boenheten er reaktivert.");
    }

    private void AskForDeleteConfirmation()
    {
        _deleteError = null;
        _confirmingDelete = true;
    }

    private void CancelDelete()
    {
        _confirmingDelete = false;
    }

    private async Task DeleteAsync()
    {
        if (_isDeleting)
        {
            return;
        }

        _isDeleting = true;
        _deleteError = null;

        try
        {
            await HousingUnitService.DeleteAsync(Id);

            Navigation.NavigateTo("/boenheter?status=slettet");
        }
        catch (HousingUnitInUseException)
        {
            _deleteError = "Boenheten kan ikke slettes fordi den er knyttet til styresaker eller oppgaver. "
                + "Fjern koblingene først, eller deaktiver boenheten i stedet.";
            _confirmingDelete = false;
        }
        catch (KeyNotFoundException)
        {
            _deleteError = "Boenheten finnes ikke lenger. Gå tilbake til oversikten.";
            _confirmingDelete = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not delete housing unit {Id}.", Id);
            _deleteError = "Kunne ikke slette boenheten. Kontroller at databasen er tilgjengelig og prøv på nytt.";
            _confirmingDelete = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task ChangeStatusAsync(Func<Task> change, string successMessage)
    {
        if (_isChangingStatus)
        {
            return;
        }

        _isChangingStatus = true;
        _message = null;
        _errorMessage = null;

        try
        {
            await change();
            _unit = await HousingUnitService.GetByIdAsync(Id);
            _message = successMessage;
        }
        catch (KeyNotFoundException)
        {
            _errorMessage = "Boenheten finnes ikke lenger.";
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not change status of housing unit {Id}.", Id);
            _errorMessage = "Kunne ikke endre status. Kontroller at databasen er tilgjengelig og prøv på nytt.";
        }
        finally
        {
            _isChangingStatus = false;
        }
    }
}
