@inject ILogger<HousingUnitForm> Logger

<EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" novalidate>
    <DataAnnotationsValidator />

    @if (_errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <section class="surface-card form-section">
        <p class="form-text mt-0">Felt merket med <span class="required-mark" aria-hidden="true">*</span> må fylles ut.</p>
        <div class="row g-3">
            <div class="col-12">
                <label for="address" class="form-label">Adresse <span class="required-mark" aria-hidden="true">*</span></label>
                <InputText id="address" @ref="_addressInput" class="form-control" @bind-Value="_model.Address"
                           maxlength="@HousingUnit.MaxAddressLength" aria-required="true" autocomplete="off" />
                <ValidationMessage For="() => _model.Address" />
            </div>
        </div>
    </section>

    <section class="surface-card form-section">
        <h2>Eier og kontaktinformasjon <span class="fs-6 fw-normal text-muted">(valgfritt)</span></h2>
        <h3 class="owner-title">Eier 1</h3>
        <div class="row g-3">
            <div class="col-12">
                <label for="ownerName" class="form-label">Navn</label>
                <InputText id="ownerName" class="form-control" @bind-Value="_model.OwnerName"
                           maxlength="@HousingUnit.MaxOwnerNameLength" autocomplete="off" />
                <ValidationMessage For="() => _model.OwnerName" />
            </div>
            <div class="col-md-6">
                <label for="ownerPhoneNumber" class="form-label">Telefon</label>
                <InputText id="ownerPhoneNumber" type="tel" class="form-control" @bind-Value="_model.OwnerPhoneNumber"
                           maxlength="@HousingUnit.MaxPhoneNumberLength" autocomplete="off" />
                <ValidationMessage For="() => _model.OwnerPhoneNumber" />
            </div>
            <div class="col-md-6">
                <label for="ownerEmail" class="form-label">E-post</label>
                <InputText id="ownerEmail" type="email" class="form-control" @bind-Value="_model.OwnerEmail"
                           maxlength="@HousingUnit.MaxEmailLength" autocomplete="off" />
                <ValidationMessage For="() => _model.OwnerEmail" />
            </div>
        </div>

        @if (_showSecondOwner)
        {
            <div class="owner-heading">
                <h3 class="owner-title">Eier 2</h3>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RemoveSecondOwner">Fjern eier 2</button>
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <label for="secondOwnerName" class="form-label">Navn</label>
                    <InputText id="secondOwnerName" class="form-control" @bind-Value="_model.SecondOwnerName"
                               maxlength="@HousingUnit.MaxOwnerNameLength" autocomplete="off" />
                    <ValidationMessage For="() => _model.SecondOwnerName" />
                </div>
                <div class="col-md-6">
                    <label for="secondOwnerPhoneNumber" class="form-label">Telefon</label>
                    <InputText id="secondOwnerPhoneNumber" type="tel" class="form-control" @bind-Value="_model.SecondOwnerPhoneNumber"
                               maxlength="@HousingUnit.MaxPhoneNumberLength" autocomplete="off" />
                    <ValidationMessage For="() => _model.SecondOwnerPhoneNumber" />
                </div>
                <div class="col-md-6">
                    <label for="secondOwnerEmail" class="form-label">E-post</label>
                    <InputText id="secondOwnerEmail" type="email" class="form-control" @bind-Value="_model.SecondOwnerEmail"
                               maxlength="@HousingUnit.MaxEmailLength" autocomplete="off" />
                    <ValidationMessage For="() => _model.SecondOwnerEmail" />
                </div>
            </div>
        }
        else
        {
            <button type="button" class="btn btn-outline-primary btn-sm mt-3" @onclick="AddSecondOwner">+ Legg til eier 2</button>
        }
    </section>

    <Disclosure Label="Flere valg" Hint="Bolignummer · Seksjonsnummer · Boligtype · Areal · Merknader" Open="_startOpen" ForceOpen="HasHiddenError()">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="unitNumber" class="form-label">Bolignummer</label>
                <InputText id="unitNumber" class="form-control" @bind-Value="_model.UnitNumber"
                           maxlength="@HousingUnit.MaxUnitNumberLength" aria-describedby="unitNumber-help" autocomplete="off" />
                <div id="unitNumber-help" class="form-text">For eksempel H0101.</div>
                <ValidationMessage For="() => _model.UnitNumber" />
            </div>
            <div class="col-md-6">
                <label for="sectionNumber" class="form-label">Seksjonsnummer</label>
                <InputNumber id="sectionNumber" class="form-control" @bind-Value="_model.SectionNumber"
                             ParsingErrorMessage="Seksjonsnummer må være et helt tall." inputmode="numeric" />
                <ValidationMessage For="() => _model.SectionNumber" />
            </div>
            <div class="col-md-6">
                <label for="housingType" class="form-label">Boligtype</label>
                <InputSelect id="housingType" class="form-select" @bind-Value="_model.HousingType">
                    <option value="">Ikke valgt</option>
                    @foreach (var housingType in HousingTypeText.All)
                    {
                        <option value="@housingType">@HousingTypeText.ToNorwegian(housingType)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _model.HousingType" />
            </div>
            <div class="col-md-6">
                <label for="areaSquareMeters" class="form-label">Areal (m²)</label>
                <InputNumber id="areaSquareMeters" class="form-control" @bind-Value="_model.AreaSquareMeters"
                             ParsingErrorMessage="Arealet må være et tall, for eksempel 85.5." inputmode="decimal" />
                <ValidationMessage For="() => _model.AreaSquareMeters" />
            </div>
            <div class="col-12">
                <label for="notes" class="form-label">Merknader</label>
                <InputTextArea id="notes" class="form-control" rows="4" @bind-Value="_model.Notes"
                               maxlength="@HousingUnit.MaxNotesLength" />
                <ValidationMessage For="() => _model.Notes" />
            </div>
        </div>
    </Disclosure>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>Lagrer …</span>
            }
            else
            {
                @SubmitText
            }
        </button>
        <a class="btn btn-outline-secondary" href="@CancelHref">Avbryt</a>
    </div>
</EditForm>

@code {
    private HousingUnitFormModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private InputText? _addressInput;
    private bool _showSecondOwner;
    private bool _startOpen;
    private bool _isSaving;
    private string? _errorMessage;

    [Parameter]
    public HousingUnit? Unit { get; set; }

    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = string.Empty;

    [Parameter]
    public string CancelHref { get; set; } = "/boenheter";

    [Parameter, EditorRequired]
    public Func<HousingUnitDetails, Task> OnSave { get; set; } = _ => Task.CompletedTask;

    protected override void OnInitialized()
    {
        _model = Unit == null ? new HousingUnitFormModel() : HousingUnitFormModel.From(Unit);
        _showSecondOwner = _model.HasSecondOwnerData;
        _startOpen = Unit != null && HasHiddenValues();

        _editContext = new EditContext(_model);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnValidationRequested += (_, _) => _messageStore.Clear();
        _editContext.OnFieldChanged += (_, e) => _messageStore.Clear(e.FieldIdentifier);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _addressInput?.Element is { } element)
        {
            await element.FocusAsync();
        }
    }

    private bool HasHiddenValues()
    {
        return !string.IsNullOrWhiteSpace(_model.UnitNumber)
            || _model.SectionNumber != null
            || !string.IsNullOrEmpty(_model.HousingType?.ToString())
            || _model.AreaSquareMeters != null
            || !string.IsNullOrWhiteSpace(_model.Notes);
    }

    private bool HasHiddenError()
    {
        return HasError(nameof(HousingUnitFormModel.UnitNumber))
            || HasError(nameof(HousingUnitFormModel.SectionNumber))
            || HasError(nameof(HousingUnitFormModel.HousingType))
            || HasError(nameof(HousingUnitFormModel.AreaSquareMeters))
            || HasError(nameof(HousingUnitFormModel.Notes));
    }

    private bool HasError(string fieldName)
    {
        return _editContext.GetValidationMessages(_editContext.Field(fieldName)).Any();
    }

    private void AddSecondOwner()
    {
        _showSecondOwner = true;
    }

    private void RemoveSecondOwner()
    {
        _model.ClearSecondOwner();
        _messageStore.Clear();
        _showSecondOwner = false;
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            await OnSave(_model.ToDetails());
        }
        catch (ArgumentException exception) when (HousingUnitFieldMessages.TryGet(exception.ParamName, out _))
        {
            ShowFieldError(exception.ParamName!);
        }
        catch (ArgumentException)
        {
            _errorMessage = "En av verdiene er ugyldig. Kontroller skjemaet og prøv på nytt.";
        }
        catch (KeyNotFoundException)
        {
            _errorMessage = "Boenheten finnes ikke lenger. Gå tilbake til oversikten og prøv på nytt.";
        }
        catch (Exception exception)
        {
            // Only the exception is logged, never the form values, because they can be personal data.
            Logger.LogError(exception, "Could not save housing unit.");
            _errorMessage = "Kunne ikke lagre. Kontroller at databasen er tilgjengelig og prøv på nytt.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ShowFieldError(string fieldName)
    {
        HousingUnitFieldMessages.TryGet(fieldName, out var message);

        _messageStore.Add(_editContext.Field(fieldName), message);
        _editContext.NotifyValidationStateChanged();
    }
}
