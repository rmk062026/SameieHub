@page "/boenheter/ny"
@inject HousingUnitService HousingUnitService
@inject NavigationManager Navigation

<PageTitle>Ny boenhet – SameieHub</PageTitle>

<PageHeader Title="Ny boenhet" Description="Bare adressen er obligatorisk. Eier og kontaktopplysninger legger du inn hvis du har dem."
            BackHref="/boenheter" BackText="Boenheter" />

<HousingUnitForm SubmitText="Registrer boenhet" OnSave="RegisterAsync" />

@code {
    private async Task RegisterAsync(HousingUnitDetails details)
    {
        var unit = await HousingUnitService.RegisterAsync(details);

        Navigation.NavigateTo($"/boenheter/{unit.Id}?status=opprettet");
    }
}
