@page "/boenheter"
@inject HousingUnitService HousingUnitService
@inject ILogger<HousingUnitList> Logger

<PageTitle>Boenheter – SameieHub</PageTitle>

<PageHeader Title="Boenheter" Description="Oversikt over boligene i sameiet.">
    <a class="btn btn-primary" href="/boenheter/ny">Ny boenhet</a>
</PageHeader>

@if (StatusMessage != null)
{
    <div class="alert alert-success" role="status">@StatusMessage</div>
}

@if (_isLoading)
{
    <div class="surface-card" role="status">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Laster boenheter …
    </div>
}
else if (_loadError != null)
{
    <div class="alert alert-danger" role="alert">
        <p>@_loadError</p>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Prøv igjen</button>
    </div>
}
else if (_allUnits.Count == 0)
{
    <section class="surface-card empty-state">
        <h2>Ingen boenheter registrert ennå</h2>
        <p>Registrer den første boenheten for å komme i gang.</p>
        <a class="btn btn-primary" href="/boenheter/ny">Ny boenhet</a>
    </section>
}
else
{
    <div class="stat-row">
        <div class="stat-card"><span class="stat-value">@_allUnits.Count</span><span class="stat-label">Registrerte</span></div>
        <div class="stat-card"><span class="stat-value">@ActiveCount</span><span class="stat-label">Aktive</span></div>
        <div class="stat-card"><span class="stat-value">@(_allUnits.Count - ActiveCount)</span><span class="stat-label">Inaktive</span></div>
    </div>

    <div class="toolbar">
        <input type="search" class="form-control" aria-label="Søk i boenheter"
               placeholder="Søk i adresse, eier, bolignummer eller seksjon"
               @bind="_searchText" @bind:event="oninput" />
        <div class="btn-group" role="group" aria-label="Filtrer på status">
            @foreach (var option in StatusOptions)
            {
                <button type="button" class="btn @(_statusFilter == option.Filter ? "btn-primary" : "btn-outline-primary")"
                        aria-pressed="@(_statusFilter == option.Filter ? "true" : "false")"
                        @onclick="() => _statusFilter = option.Filter">
                    @option.Text
                </button>
            }
        </div>
    </div>

    var visibleUnits = GetVisibleUnits();

    @if (visibleUnits.Count == 0)
    {
        <section class="surface-card empty-state">
            <h2>Ingen boenheter funnet</h2>
            <p>Ingen boenheter passer med søket og filteret ditt.</p>
            <button type="button" class="btn btn-outline-primary" @onclick="ResetFilters">Nullstill søk og filter</button>
        </section>
    }
    else
    {
        <p class="summary" role="status">Viser <strong>@visibleUnits.Count</strong> av @_allUnits.Count @(_allUnits.Count == 1 ? "boenhet" : "boenheter")</p>

        <div class="data-table-card">
            <table class="table data-table table-cards" data-testid="unit-table">
                <caption class="visually-hidden">Registrerte boenheter, sortert etter adresse</caption>
                <thead>
                    <tr>
                        <th scope="col">Adresse</th>
                        <th scope="col">Eier</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var unit in visibleUnits)
                    {
                        <tr data-testid="unit-row">
                            <td data-label="Adresse">
                                <div>
                                    <a class="unit-link" href="/boenheter/@unit.Id">@unit.Address</a>
                                    @if (ShowUnitNumber(unit))
                                    {
                                        <div class="unit-sub">@unit.UnitNumber</div>
                                    }
                                </div>
                            </td>
                            <td data-label="Eier" class="owner-cell">
                                @if (HasOwner(unit))
                                {
                                    @OwnerText(unit)
                                }
                                else
                                {
                                    <span class="text-muted">Ikke registrert</span>
                                }
                            </td>
                            <td data-label="Status"><HousingUnitStatusBadge IsActive="unit.IsActive" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private static readonly (HousingUnitStatusFilter Filter, string Text)[] StatusOptions =
    [
        (HousingUnitStatusFilter.Active, "Aktive"),
        (HousingUnitStatusFilter.Inactive, "Inaktive"),
        (HousingUnitStatusFilter.All, "Alle")
    ];

    // Numeric ordering puts "Storgata 2A" before "Storgata 10B".
    private static readonly IComparer<string> AddressComparer = Comparer<string>.Create((first, second) =>
        new System.Globalization.CultureInfo("nb-NO").CompareInfo.Compare(
            first, second, System.Globalization.CompareOptions.IgnoreCase | System.Globalization.CompareOptions.NumericOrdering));

    private IReadOnlyList<HousingUnit> _allUnits = [];
    private string _searchText = string.Empty;
    private HousingUnitStatusFilter _statusFilter = HousingUnitStatusFilter.Active;
    private bool _isLoading = true;
    private string? _loadError;

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private string? StatusMessage => Status == "slettet" ? "Boenheten er slettet permanent." : null;

    private int ActiveCount => _allUnits.Count(unit => unit.IsActive);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            _allUnits = await HousingUnitService.GetAllAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load housing units.");
            _loadError = "Kunne ikke hente boenhetene. Kontroller at databasen er tilgjengelig og prøv igjen.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<HousingUnit> GetVisibleUnits()
    {
        var filtered = HousingUnitFilter.Apply(_allUnits, _searchText, _statusFilter);

        return filtered.OrderBy(unit => unit.Address, AddressComparer).ToList();
    }

    private void ResetFilters()
    {
        _searchText = string.Empty;
        _statusFilter = HousingUnitStatusFilter.All;
    }

    private static bool HasOwner(HousingUnit unit) => unit.OwnerName != null || unit.SecondOwnerName != null;

    private static bool ShowUnitNumber(HousingUnit unit)
    {
        return unit.UnitNumber != null && !unit.Address.Contains(unit.UnitNumber, StringComparison.OrdinalIgnoreCase);
    }

    private static string OwnerText(HousingUnit unit)
    {
        var names = new List<string>();
        if (unit.OwnerName != null)
        {
            names.Add(unit.OwnerName);
        }

        if (unit.SecondOwnerName != null)
        {
            names.Add(unit.SecondOwnerName);
        }

        return names.Count == 0 ? "–" : string.Join(" og ", names);
    }
}
