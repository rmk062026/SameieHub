<div class="reconciliation @(Compact ? "reconciliation-compact" : "")" data-testid="reconciliation">
    <div class="reconciliation-status">
        @if (Reconciliation.IsComplete)
        {
            <span class="status-badge status-decided">Fullstendig</span>
        }
        else
        {
            <span class="status-badge status-in-progress">Ufullstendig</span>
        }
        @if (Reconciliation.HasApproximateReadings)
        {
            <span class="status-badge status-new">Tilnærmet</span>
        }
        <span class="reconciliation-period">Periode: @ChargingText.Period(Reconciliation.From, Reconciliation.To)</span>
    </div>

    @if (Compact)
    {
        <p class="mb-1" data-testid="reconciliation-summary">
            @if (Reconciliation.Difference is { } compactDifference)
            {
                <span>Differanse mellom hovedmåler og undermålere: <strong data-testid="difference">@ChargingText.SignedKwh(compactDifference)</strong>@if (Reconciliation.DifferencePercent is { } compactPercent) { <span> (<span data-testid="difference-percent">@ChargingText.Percent(compactPercent)</span>)</span> }.</span>
            }
            else
            {
                <span>Differansen er <strong data-testid="difference">ikke beregnet</strong> fordi grunnlaget er ufullstendig.</span>
            }
        </p>
    }
    else
    {
        <dl class="detail-list reconciliation-summary">
            <div class="detail-item">
                <dt>Forbruk i perioden målt av hovedmåleren</dt>
                <dd>@(Reconciliation.MainKwh is { } main ? ChargingText.Kwh(main) : "Mangler")</dd>
            </div>
            <div class="detail-item">
                <dt>Sum av forbruk i perioden på undermålerne@(Reconciliation.IsComplete ? "" : " (bare dokumenterte)")</dt>
                <dd>@ChargingText.Kwh(Reconciliation.SubMeterKwh)</dd>
            </div>
            <div class="detail-item">
                <dt>Differanse (hovedmåler − undermålere)</dt>
                <dd>
                    <strong data-testid="difference">@(Reconciliation.Difference is { } difference ? ChargingText.SignedKwh(difference) : "Ikke beregnet")</strong>
                    @if (Reconciliation.DifferencePercent is { } percent)
                    {
                        <span>&nbsp;(<span data-testid="difference-percent">@ChargingText.Percent(percent)</span> av hovedmålerens forbruk)</span>
                    }
                </dd>
            </div>
        </dl>

        <div class="reconciliation-explanation" data-testid="difference-explanation">
            <p class="mb-1">
                Hovedmåleren viser forbruket for hele ladeanlegget i perioden, og undermålerne viser forbruket til hver enkelt lader.
                Forbruket er forskjellen mellom to målerstander. Differansen er forskjellen mellom hovedmålerens forbruk og summen av undermålernes forbruk.
            </p>
            @if (Reconciliation.Difference is { } explained)
            {
                <p class="mb-1">@DirectionText(explained)</p>
                <p class="mb-0">
                    En differanse er ikke i seg selv et tap eller bevis på feil i anlegget. Små avvik er vanlige, blant annet fordi målerne ikke leses av på nøyaktig samme tidspunkt.
                    @if (Reconciliation.DifferencePercent == null)
                    {
                        <span> Prosent kan ikke beregnes fordi hovedmåleren viste 0 kWh.</span>
                    }
                </p>
            }
            else
            {
                <p class="mb-0">Differansen vises ikke, fordi den ville gitt et misvisende resultat når avlesninger mangler.</p>
            }
        </div>
    }

    @if (!Reconciliation.IsComplete && Compact)
    {
        <p class="mb-1 text-muted" data-testid="missing-summary">Det mangler avlesninger eller målere. Se avstemmingen for hva som mangler.</p>
    }
    else if (!Reconciliation.IsComplete)
    {
        <div class="alert alert-warning" role="status">
            <strong>Avstemmingen er ufullstendig, så differansen er ikke beregnet.</strong> Manglende verdier estimeres ikke og regnes aldri som 0.
            <ul class="mb-0 mt-2">
                @if (Reconciliation.Main == null)
                {
                    <li>Hovedmåleren er ikke satt opp.</li>
                }
                @if (Reconciliation.MissingSubMeterCount > 0)
                {
                    <li>Bare @Reconciliation.ConfiguredSubMeterCount av @Reconciliation.ExpectedSubMeterCount undermålere er satt opp. @Reconciliation.MissingSubMeterCount mangler (registrer flere ladere).</li>
                }
                @if (Reconciliation.ConfiguredSubMeterCount > Reconciliation.ExpectedSubMeterCount || Reconciliation.SubMeters.Count > Reconciliation.ExpectedSubMeterCount)
                {
                    <li>Det er flere undermålere enn de @Reconciliation.ExpectedSubMeterCount som er forventet. Kontroller oppsettet.</li>
                }
                @foreach (var line in Reconciliation.MissingMeters)
                {
                    <li><strong>@Label(line)</strong>: @ChargingText.StateText(line.Consumption.State).ToLowerInvariant().</li>
                }
            </ul>
        </div>
    }

    @if (Reconciliation.HasApproximateReadings && !Compact)
    {
        <div class="alert alert-info" role="status">
            <strong>Tilnærmet:</strong> noen målere er ikke avlest nøyaktig ved periodens start eller slutt, men innenfor
            @((int)Reconciliation.Tolerance.TotalHours) timer. Forbruket for dem gjelder da tiden mellom de faktiske avlesningene, ikke nøyaktig perioden.
        </div>
    }

    @if (ShowDetails)
    {
        <div class="table-responsive">
            <table class="table data-table">
                <caption class="visually-hidden">Forbruk i perioden per måler</caption>
                <thead>
                    <tr>
                        <th scope="col">Måler</th>
                        <th scope="col" class="d-none d-md-table-cell">Skap</th>
                        <th scope="col">Forbruk i perioden</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in AllLines())
                    {
                        <tr>
                            <td>
                                @if (line.Meter.EvChargerId is { } chargerId)
                                {
                                    <a class="unit-link" href="/elbillading/@chargerId">@Label(line)</a>
                                }
                                else
                                {
                                    <a class="unit-link" href="/elbillading/maler/@line.Meter.Id">@Label(line)</a>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">@(line.Meter.CabinetNumber?.ToString() ?? "–")</td>
                            <td>@(line.Consumption.Kwh is { } kwh ? ChargingText.Kwh(kwh) : "Mangler")</td>
                            <td>
                                @ChargingText.StateText(line.Consumption.State)
                                @if (line.Consumption.State == MeterConsumptionState.Documented)
                                {
                                    <div class="unit-sub">
                                        Avlest @ChargingText.Time(line.Consumption.StartReading!.ReadAt) og @ChargingText.Time(line.Consumption.EndReading!.ReadAt)
                                    </div>
                                    @if (line.Consumption.IsApproximate)
                                    {
                                        <span class="status-badge status-new">Tilnærmet</span>
                                        <div class="unit-sub">Perioden er @ChargingText.Time(Reconciliation.From) – @ChargingText.Time(Reconciliation.To).</div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ChargingReconciliation Reconciliation { get; set; } = default!;

    /// <summary>Used for the addresses shown for the sub meters.</summary>
    [Parameter]
    public IReadOnlyList<HousingUnit> Units { get; set; } = [];

    /// <summary>Shows the table with every meter. The overview page shows only the summary.</summary>
    [Parameter]
    public bool ShowDetails { get; set; }

    /// <summary>One short line for the overview. The full view explains the numbers.</summary>
    [Parameter]
    public bool Compact { get; set; }

    private static string DirectionText(decimal difference)
    {
        if (difference > 0)
        {
            return "En positiv differanse betyr at hovedmåleren viser mer forbruk enn summen av undermålerne.";
        }

        return difference < 0
            ? "En negativ differanse betyr at undermålerne til sammen viser mer forbruk enn hovedmåleren."
            : "Hovedmåleren og summen av undermålerne viser like mye forbruk.";
    }

    private IEnumerable<ReconciliationLine> AllLines()
    {
        if (Reconciliation.Main != null)
        {
            yield return Reconciliation.Main;
        }

        foreach (var line in Reconciliation.SubMeters)
        {
            yield return line;
        }
    }

    private string Label(ReconciliationLine line)
    {
        var unit = line.Charger == null ? null : Units.FirstOrDefault(existing => existing.Id == line.Charger.HousingUnitId);

        return ChargingText.MeterLabel(line.Meter, line.Charger, unit);
    }
}
