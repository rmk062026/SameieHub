@inject ChargingService ChargingService
@inject HousingUnitService HousingUnitService
@inject ILogger<DashboardChargingSection> Logger

<section class="surface-card" aria-labelledby="dashboard-charging-title" data-testid="charging-status">
    <h2 id="dashboard-charging-title">Elbillading</h2>

    @if (_failed)
    {
        <p class="text-muted mb-2">Kunne ikke hente elbillading.</p>
    }
    else if (_overview == null)
    {
        <p class="text-muted mb-2">Ladeanlegget er ikke satt opp.</p>
    }
    else if (_reconciliation == null)
    {
        <p class="mb-2">
            @if (_overview.MainMeterLastReading != null)
            {
                <span>Hovedmåler: @ChargingText.Kwh(_overview.MainMeterLastReading.Kwh), avlest @ChargingText.Time(_overview.MainMeterLastReading.ReadAt). </span>
            }
            <span class="text-muted">Ingen avstemming ennå. Den krever to avlesninger av hovedmåleren.</span>
        </p>
    }
    else if (_reconciliation.IsComplete)
    {
        <p class="mb-2">
            Siste avstemming (@ChargingText.Period(_reconciliation.From, _reconciliation.To)):
            differanse <strong>@ChargingText.SignedKwh(_reconciliation.Difference!.Value)</strong>@(_reconciliation.DifferencePercent is { } percent ? $" ({ChargingText.Percent(percent)})" : "")@(_reconciliation.HasApproximateReadings ? ", tilnærmet" : "").
        </p>
    }
    else
    {
        <p class="mb-2">Siste avstemming er <strong>ufullstendig</strong>. Differansen er ikke beregnet. <a href="/elbillading/avstemming">Se hva som mangler</a>.</p>
    }

    <div class="form-actions">
        <a class="btn btn-outline-primary btn-sm" href="/elbillading">Elbillading</a>
        @if (_overview != null)
        {
            <a class="btn btn-outline-primary btn-sm" href="/elbillading/avlesning">Registrer avlesning</a>
        }
    </div>
</section>

@code {
    private ChargingOverview? _overview;
    private ChargingReconciliation? _reconciliation;
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await ChargingService.GetFacilityAsync() == null)
            {
                return;
            }

            var units = await HousingUnitService.GetAllAsync();
            var chargers = await ChargingService.GetChargersAsync();
            var meters = await ChargingService.GetMetersAsync();
            var readings = await ChargingService.GetAllReadingsAsync();

            _overview = ChargingOverview.Create(units, chargers, meters, readings);
            _reconciliation = await ChargingService.ReconcileLatestPeriodAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load the charging section of the dashboard.");
            _failed = true;
        }
    }
}
