@inject ILogger<TaskForm> Logger

<EditForm EditContext="_editContext" OnValidSubmit="SaveAsync" novalidate>
    <DataAnnotationsValidator />

    @if (_errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@_errorMessage</div>
    }

    <section class="surface-card form-section">
        <p class="form-text mt-0">Felt merket med <span class="required-mark" aria-hidden="true">*</span> må fylles ut.</p>
        <div class="row g-3">
            <div class="col-12">
                <label for="title" class="form-label">Tittel <span class="required-mark" aria-hidden="true">*</span></label>
                <InputText id="title" @ref="_titleInput" class="form-control" @bind-Value="_model.Title"
                           maxlength="@TaskItem.MaxTitleLength" aria-required="true" autocomplete="off" />
                <ValidationMessage For="() => _model.Title" role="alert" />
            </div>
            <div class="col-md-6">
                <label for="assignedTo" class="form-label">Ansvarlig</label>
                <InputText id="assignedTo" class="form-control" @bind-Value="_model.AssignedTo"
                           maxlength="@TaskItem.MaxAssignedToLength" autocomplete="off" />
                <ValidationMessage For="() => _model.AssignedTo" role="alert" />
            </div>
            <div class="col-md-6">
                <label for="dueDate" class="form-label">Frist</label>
                <InputDate id="dueDate" class="form-control" @bind-Value="_model.DueDate"
                           ParsingErrorMessage="Fristen må være en gyldig dato." />
                <ValidationMessage For="() => _model.DueDate" role="alert" />
            </div>
            <div class="col-12">
                <ScopeField UnitMode="_unitMode" UnitModeChanged="SetUnitMode"
                            HousingUnitId="_model.HousingUnitId" HousingUnitIdChanged="SetHousingUnit"
                            For="() => _model.HousingUnitId" Units="AvailableHousingUnits" Error="@_scopeError"
                            Help="Velg «Hele sameiet» for et vanlig gjøremål. Oppgaven trenger ikke gjelde samme boenhet som en styresak." />
            </div>
            @if (_boardCaseVisible)
            {
                <div class="col-12" data-testid="board-case-field">
                    <label for="boardCaseId" class="form-label">Styresak</label>
                    <InputSelect id="boardCaseId" class="form-select" @bind-Value="_model.BoardCaseId">
                        <option value="">Ingen styresak</option>
                        @foreach (var boardCase in AvailableBoardCases)
                        {
                            <option value="@boardCase.Id">#@boardCase.Id @boardCase.Title</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.BoardCaseId" role="alert" />
                </div>
            }
        </div>
    </section>

    <Disclosure Label="Flere valg" Hint="@MoreOptionsHint" Open="_startOpen" ForceOpen="HasHiddenError()">
        <div class="row g-3">
            <div class="col-12">
                <label for="description" class="form-label">Beskrivelse</label>
                <InputTextArea id="description" class="form-control" rows="4" @bind-Value="_model.Description"
                               maxlength="@TaskItem.MaxDescriptionLength" />
                <ValidationMessage For="() => _model.Description" role="alert" />
            </div>
            <div class="col-md-6">
                <label for="category" class="form-label">Kategori</label>
                <InputSelect id="category" class="form-select" @bind-Value="_model.Category">
                    @foreach (var category in TaskText.AllCategories)
                    {
                        <option value="@category">@TaskText.CategoryText(category)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _model.Category" role="alert" />
            </div>
            <div class="col-md-6">
                <label for="priority" class="form-label">Prioritet</label>
                <InputSelect id="priority" class="form-select" @bind-Value="_model.Priority">
                    @foreach (var priority in TaskText.AllPriorities)
                    {
                        <option value="@priority">@TaskText.PriorityText(priority)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => _model.Priority" role="alert" />
            </div>
            <div class="col-12">
                <label for="notes" class="form-label">Merknader</label>
                <InputTextArea id="notes" class="form-control" rows="4" @bind-Value="_model.Notes"
                               maxlength="@TaskItem.MaxNotesLength" />
                <ValidationMessage For="() => _model.Notes" role="alert" />
            </div>
            @if (!_boardCaseVisible)
            {
                <div class="col-12" data-testid="board-case-field">
                    <label for="boardCaseId" class="form-label">Styresak</label>
                    <InputSelect id="boardCaseId" class="form-select" @bind-Value="_model.BoardCaseId" aria-describedby="boardCaseId-help">
                        <option value="">Ingen styresak</option>
                        @foreach (var boardCase in AvailableBoardCases)
                        {
                            <option value="@boardCase.Id">#@boardCase.Id @boardCase.Title</option>
                        }
                    </InputSelect>
                    <div id="boardCaseId-help" class="form-text">Bare hvis oppgaven følger av en styresak. Vanlige gjøremål trenger ingen.</div>
                    <ValidationMessage For="() => _model.BoardCaseId" role="alert" />
                </div>
            }
        </div>
    </Disclosure>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary" disabled="@_isSaving">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                <span>Lagrer …</span>
            }
            else
            {
                @SubmitText
            }
        </button>
        <a class="btn btn-outline-secondary" href="@CancelHref">Avbryt</a>
    </div>
</EditForm>

@code {
    private TaskFormModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private InputText? _titleInput;
    private bool _unitMode;
    private bool _boardCaseVisible;
    private bool _startOpen;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _scopeError;

    [Parameter]
    public TaskItem? Existing { get; set; }

    /// <summary>The housing unit chosen when a new task is registered. Must be one of the available units.</summary>
    [Parameter]
    public int? InitialHousingUnitId { get; set; }

    /// <summary>The board case chosen when a new task is registered. Must be one of the available cases.</summary>
    [Parameter]
    public int? InitialBoardCaseId { get; set; }

    /// <summary>The housing units the user can choose from. The page decides which ones are offered.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<HousingUnit> AvailableHousingUnits { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<BoardCase> AvailableBoardCases { get; set; } = [];

    [Parameter, EditorRequired]
    public string SubmitText { get; set; } = string.Empty;

    [Parameter]
    public string CancelHref { get; set; } = "/oppgaver";

    [Parameter, EditorRequired]
    public Func<TaskItemDetails, Task> OnSave { get; set; } = _ => Task.CompletedTask;

    private string MoreOptionsHint => _boardCaseVisible
        ? "Beskrivelse · Kategori · Prioritet · Merknader"
        : "Beskrivelse · Kategori · Prioritet · Merknader · Styresak";

    protected override void OnInitialized()
    {
        _model = Existing == null
            ? new TaskFormModel { HousingUnitId = InitialHousingUnitId, BoardCaseId = InitialBoardCaseId }
            : TaskFormModel.From(Existing);

        _unitMode = _model.HousingUnitId != null;

        // A board case that is already decided, by the page the person came from or by the saved task, must stay visible.
        _boardCaseVisible = _model.BoardCaseId != null;

        // Saved values in the optional part are never hidden from the person who edits them.
        _startOpen = Existing != null && HasHiddenValues();

        _editContext = new EditContext(_model);
        _messageStore = new ValidationMessageStore(_editContext);
        _editContext.OnValidationRequested += (_, _) => _messageStore.Clear();
        _editContext.OnFieldChanged += (_, e) => _messageStore.Clear(e.FieldIdentifier);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _titleInput?.Element is { } element)
        {
            await element.FocusAsync();
        }
    }

    private bool HasHiddenValues()
    {
        return !string.IsNullOrWhiteSpace(_model.Description)
            || !string.IsNullOrWhiteSpace(_model.Notes)
            || _model.Category != TaskItemCategory.General
            || _model.Priority != TaskItemPriority.Normal;
    }

    /// <summary>True when a field inside «Flere valg» has an error, so the section opens and the error is seen.</summary>
    private bool HasHiddenError()
    {
        return HasError(nameof(TaskFormModel.Description))
            || HasError(nameof(TaskFormModel.Category))
            || HasError(nameof(TaskFormModel.Priority))
            || HasError(nameof(TaskFormModel.Notes))
            || (!_boardCaseVisible && HasError(nameof(TaskFormModel.BoardCaseId)));
    }

    private bool HasError(string fieldName)
    {
        return _editContext.GetValidationMessages(_editContext.Field(fieldName)).Any();
    }

    private void SetUnitMode(bool unitMode)
    {
        _unitMode = unitMode;
        _scopeError = null;
    }

    private void SetHousingUnit(int? housingUnitId)
    {
        _model.HousingUnitId = housingUnitId;
        _scopeError = null;
    }

    private async Task SaveAsync()
    {
        if (_isSaving)
        {
            return;
        }

        if (_unitMode && _model.HousingUnitId == null)
        {
            _scopeError = "Velg en boenhet, eller velg «Hele sameiet».";

            return;
        }

        _isSaving = true;
        _errorMessage = null;

        try
        {
            await OnSave(_model.ToDetails());
        }
        catch (ArgumentException exception) when (TaskFieldMessages.TryGet(exception.ParamName, out _))
        {
            ShowFieldError(exception.ParamName!);
        }
        catch (ArgumentException)
        {
            _errorMessage = "En av verdiene er ugyldig. Kontroller skjemaet og prøv på nytt.";
        }
        catch (KeyNotFoundException)
        {
            _errorMessage = "Oppgaven finnes ikke lenger. Gå tilbake til oversikten.";
        }
        catch (Exception exception)
        {
            // Only the exception is logged, never the form values.
            Logger.LogError(exception, "Could not save task.");
            _errorMessage = "Kunne ikke lagre. Kontroller at databasen er tilgjengelig og prøv på nytt.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ShowFieldError(string fieldName)
    {
        TaskFieldMessages.TryGet(fieldName, out var message);

        _messageStore.Add(_editContext.Field(fieldName), message);
        _editContext.NotifyValidationStateChanged();
    }
}
