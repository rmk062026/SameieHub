@page "/oppgaver"
@inject TaskItemService TaskService
@inject HousingUnitService HousingUnitService
@inject BoardCaseService BoardCaseService
@inject ILogger<TaskList> Logger

<PageTitle>Oppgaver – SameieHub</PageTitle>

<PageHeader Title="Oppgaver" Description="Hva som skal gjøres i sameiet, hvem som er ansvarlig og når det skal være ferdig.">
    <PrimaryAction><a class="btn btn-primary" href="/oppgaver/ny">Ny oppgave</a></PrimaryAction>
</PageHeader>

@if (StatusMessage != null)
{
    <div class="alert alert-success" role="status">@StatusMessage</div>
}

@if (_isLoading)
{
    <div class="surface-card" role="status">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Laster oppgaver …
    </div>
}
else if (_loadError != null)
{
    <div class="alert alert-danger" role="alert">
        <p>@_loadError</p>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Prøv igjen</button>
    </div>
}
else if (_allTasks.Count == 0)
{
    <section class="surface-card empty-state" data-testid="no-tasks">
        <h2>Ingen oppgaver registrert ennå</h2>
        <p>Registrer den første oppgaven for å komme i gang.</p>
        <a class="btn btn-primary" href="/oppgaver/ny">Ny oppgave</a>
    </section>
}
else
{
    var today = TaskService.GetToday();
    var visibleTasks = GetVisibleTasks(today);

    <QuickTabs AriaLabel="Vis oppgaver" Tabs="GetTabs(today)" Selected="@_tab" SelectedChanged="ChooseTab" />

    <div class="list-search">
        <label for="task-search" class="visually-hidden">Søk i oppgaver</label>
        <input id="task-search" type="search" class="form-control" data-testid="task-search"
               placeholder="Søk i tittel, beskrivelse, ansvarlig eller oppgavenummer"
               @bind="SearchText" @bind:event="oninput" />
    </div>

    <Disclosure Label="Flere filtre" Hint="Status · Kategori · Prioritet · Boenhet · Styresak · Sortering">
        <div class="filter-grid">
            <div>
                <label for="filter-status" class="form-label">Status</label>
                <select id="filter-status" class="form-select" @bind="StatusValue">
                    <option value="">Følger valgt visning</option>
                    @foreach (var status in TaskText.AllStatuses)
                    {
                        <option value="@status">@TaskText.StatusText(status)</option>
                    }
                    <option value="@AllValue">Alle (også fullførte)</option>
                </select>
            </div>
            <div>
                <label for="filter-category" class="form-label">Kategori</label>
                <select id="filter-category" class="form-select" @bind="CategoryValue">
                    <option value="">Alle kategorier</option>
                    @foreach (var category in TaskText.AllCategories)
                    {
                        <option value="@category">@TaskText.CategoryText(category)</option>
                    }
                </select>
            </div>
            <div>
                <label for="filter-priority" class="form-label">Prioritet</label>
                <select id="filter-priority" class="form-select" @bind="PriorityValue">
                    <option value="">Alle prioriteter</option>
                    @foreach (var priority in TaskText.AllPriorities)
                    {
                        <option value="@priority">@TaskText.PriorityText(priority)</option>
                    }
                </select>
            </div>
            <div>
                <label for="filter-unit" class="form-label">Boenhet</label>
                <select id="filter-unit" class="form-select" @bind="HousingUnitValue">
                    <option value="">Alle boenheter</option>
                    @foreach (var unit in _housingUnits)
                    {
                        <option value="@unit.Id">@unit.Address@(unit.IsActive ? "" : " (inaktiv)")</option>
                    }
                </select>
            </div>
            <div>
                <label for="filter-case" class="form-label">Styresak</label>
                <select id="filter-case" class="form-select" @bind="BoardCaseValue">
                    <option value="">Alle styresaker</option>
                    @foreach (var boardCase in _boardCases)
                    {
                        <option value="@boardCase.Id">#@boardCase.Id @boardCase.Title</option>
                    }
                </select>
            </div>
            <div>
                <label for="filter-sort" class="form-label">Sortering</label>
                <select id="filter-sort" class="form-select" @bind="SortOrder">
                    @foreach (var order in Enum.GetValues<TaskItemSortOrder>())
                    {
                        <option value="@order">@TaskText.SortOrderText(order)</option>
                    }
                </select>
            </div>
        </div>
    </Disclosure>

    <ActiveFilters Filters="GetActiveFilters()" OnRemove="RemoveFilter" OnClearAll="ResetFilters" />

    @if (visibleTasks.Count == 0)
    {
        <section class="surface-card empty-state" data-testid="empty-list">
            <h2>Ingen oppgaver funnet</h2>
            <p>Sameiet har @_allTasks.Count @(_allTasks.Count == 1 ? "oppgave" : "oppgaver") i alt, men ingen passer med valgt visning, søk og filtre.</p>
            <button type="button" class="btn btn-outline-primary" @onclick="ResetFilters">Nullstill søk og filtre</button>
            @if (_tab == OpenTab && !HasExtraFilters)
            {
                <button type="button" class="btn btn-link" @onclick="ShowAll">Vis også fullførte</button>
            }
        </section>
    }
    else
    {
        <p class="summary" role="status" data-testid="list-summary">Viser <strong>@visibleTasks.Count</strong> av @_allTasks.Count @(_allTasks.Count == 1 ? "oppgave" : "oppgaver")</p>

        <div class="data-table-card task-table-wrap">
            <table class="table data-table table-cards" data-testid="task-table">
                <caption class="visually-hidden">Oppgaver</caption>
                <thead>
                    <tr>
                        <th scope="col">Oppgave</th>
                        <th scope="col">Ansvarlig</th>
                        <th scope="col">Frist</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Handling</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in visibleTasks)
                    {
                        <tr data-testid="task-row" data-task-id="@task.Id">
                            <td data-label="Oppgave">
                                <div>
                                    <a class="unit-link" data-testid="task-title" href="/oppgaver/@task.Id">@task.Title</a>
                                    @if (task.Priority == TaskItemPriority.High)
                                    {
                                        <span class="status-badge priority-high ms-1" data-testid="high-priority">Høy prioritet</span>
                                    }
                                    <div class="unit-sub" data-testid="task-scope">
                                        @if (task.BoardCaseId is { } boardCaseId)
                                        {
                                            <a href="/styresaker/@boardCaseId">@BoardCaseText(boardCaseId)</a>
                                        }
                                        @if (task.BoardCaseId != null && task.HousingUnitId != null)
                                        {
                                            <span> · </span>
                                        }
                                        @if (task.HousingUnitId is { } unitId)
                                        {
                                            <a href="/boenheter/@unitId">@HousingUnitText(unitId)</a>
                                        }
                                        @if (task.BoardCaseId == null && task.HousingUnitId == null)
                                        {
                                            <span>Hele sameiet</span>
                                        }
                                    </div>
                                    @if (_feedback.TryGetValue(task.Id, out var feedback))
                                    {
                                        <ActionFeedback Message="@feedback.Message" Kind="feedback.Kind"
                                                        ActionText="@(feedback.UndoTo == null ? null : "Angre")"
                                                        OnAction="() => UndoAsync(task.Id)"
                                                        OnDismiss="() => DismissFeedback(task.Id)" />
                                    }
                                </div>
                            </td>
                            <td data-label="Ansvarlig" data-testid="task-assignee">
                                @if (string.IsNullOrWhiteSpace(task.AssignedTo))
                                {
                                    <span class="text-muted">Ikke tildelt</span>
                                }
                                else
                                {
                                    @task.AssignedTo
                                }
                            </td>
                            <td data-label="Frist" data-testid="task-due"><span class="cell-value"><TaskDueDate Task="task" Today="today" /></span></td>
                            <td data-label="Status"><TaskStatusBadge Status="task.Status" /></td>
                            <td data-label="">
                                @if (task.Status == TaskItemStatus.Completed)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-testid="reopen-task"
                                            aria-label="Gjenåpne oppgaven «@task.Title»"
                                            disabled="@_busyIds.Contains(task.Id)" @onclick="() => ReopenAsync(task)">Gjenåpne</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm" data-testid="complete-task"
                                            aria-label="Fullfør oppgaven «@task.Title»"
                                            disabled="@_busyIds.Contains(task.Id)" @onclick="() => CompleteAsync(task)">Fullfør</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const string OpenTab = "open";
    private const string OverdueTab = "overdue";
    private const string DoneTab = "done";
    private const string AllValue = "all";

    private sealed record RowFeedback(string Message, FeedbackKind Kind, TaskItemStatus? UndoTo);

    private readonly Dictionary<int, RowFeedback> _feedback = [];
    private readonly HashSet<int> _busyIds = [];

    /// <summary>Where in the list each task with a message was when the person acted on it, so the row does not jump away.</summary>
    private readonly Dictionary<int, int> _positions = [];

    private IReadOnlyList<TaskItem> _allTasks = [];
    private IReadOnlyList<HousingUnit> _housingUnits = [];
    private IReadOnlyList<BoardCase> _boardCases = [];
    private string _tab = OpenTab;
    private string _searchText = string.Empty;
    private string _statusValue = string.Empty;
    private string _categoryValue = string.Empty;
    private string _priorityValue = string.Empty;
    private string _housingUnitValue = string.Empty;
    private string _boardCaseValue = string.Empty;
    private TaskItemSortOrder _sortOrder = TaskItemSortOrder.DueDate;
    private bool _isLoading = true;
    private string? _loadError;

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    /// <summary>Set to 1 by the dashboard link «Forfalte oppgaver».</summary>
    [SupplyParameterFromQuery(Name = "forfalt")]
    public string? OverdueParameter { get; set; }

    private string? StatusMessage => Status == "slettet" ? "Oppgaven er slettet permanent." : null;

    private string SearchText
    {
        get => _searchText;
        set { _searchText = value; ClearSuccessFeedback(); }
    }

    /// <summary>Choosing a specific status replaces the quick choice, so the two can never contradict each other.</summary>
    private string StatusValue
    {
        get => _statusValue;
        set
        {
            _statusValue = value;
            _tab = value == string.Empty ? OpenTab : string.Empty;
            ClearSuccessFeedback();
        }
    }

    private string CategoryValue
    {
        get => _categoryValue;
        set { _categoryValue = value; ClearSuccessFeedback(); }
    }

    private string PriorityValue
    {
        get => _priorityValue;
        set { _priorityValue = value; ClearSuccessFeedback(); }
    }

    private string HousingUnitValue
    {
        get => _housingUnitValue;
        set { _housingUnitValue = value; ClearSuccessFeedback(); }
    }

    private string BoardCaseValue
    {
        get => _boardCaseValue;
        set { _boardCaseValue = value; ClearSuccessFeedback(); }
    }

    private TaskItemSortOrder SortOrder
    {
        get => _sortOrder;
        set { _sortOrder = value; ClearSuccessFeedback(); }
    }

    private bool HasExtraFilters =>
        _searchText.Trim().Length > 0 || _categoryValue != string.Empty || _priorityValue != string.Empty
        || _housingUnitValue != string.Empty || _boardCaseValue != string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (OverdueParameter == "1")
        {
            _tab = OverdueTab;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            await ReloadTasksAsync();

            var units = await HousingUnitService.GetAllAsync();
            _housingUnits = units.OrderBy(unit => unit.Address).ToList();

            var boardCases = await BoardCaseService.GetAllAsync();
            _boardCases = boardCases.OrderBy(boardCase => boardCase.Id).ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load tasks.");
            _loadError = "Kunne ikke hente oppgavene. Kontroller at databasen er tilgjengelig og prøv igjen.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadTasksAsync()
    {
        _allTasks = await TaskService.GetAllAsync();
    }

    private List<QuickTab> GetTabs(DateOnly today)
    {
        return
        [
            new QuickTab(OpenTab, "Åpne", _allTasks.Count(task => task.Status != TaskItemStatus.Completed)),
            new QuickTab(OverdueTab, "Forfalte", _allTasks.Count(task => task.IsOverdue(today))),
            new QuickTab(DoneTab, "Fullførte", _allTasks.Count(task => task.Status == TaskItemStatus.Completed))
        ];
    }

    private void ChooseTab(string key)
    {
        _tab = key;
        _statusValue = string.Empty;
        ClearSuccessFeedback();
    }

    private List<TaskItem> GetVisibleTasks(DateOnly today)
    {
        var criteria = new TaskItemFilterCriteria
        {
            SearchText = _searchText,
            OpenOnly = _tab == OpenTab,
            Status = _tab == DoneTab
                ? TaskItemStatus.Completed
                : Enum.TryParse<TaskItemStatus>(_statusValue, out var status) ? status : null,
            Category = Enum.TryParse<TaskItemCategory>(_categoryValue, out var category) ? category : null,
            Priority = Enum.TryParse<TaskItemPriority>(_priorityValue, out var priority) ? priority : null,
            HousingUnitId = int.TryParse(_housingUnitValue, out var housingUnitId) ? housingUnitId : null,
            BoardCaseId = int.TryParse(_boardCaseValue, out var boardCaseId) ? boardCaseId : null,
            OverdueOn = _tab == OverdueTab ? today : null
        };

        var tasks = TaskItemFilter.Apply(_allTasks, criteria);

        // A task that was just completed or reopened stays where it was, with its message, until the person changes the view.
        var pinnedIds = _positions.Keys.ToList();

        foreach (var task in _allTasks)
        {
            if (pinnedIds.Contains(task.Id) && !tasks.Contains(task))
            {
                tasks.Add(task);
            }
        }

        var sorted = TaskItemSorting.Sort(tasks, _sortOrder);

        foreach (var id in pinnedIds.OrderBy(pinnedId => _positions[pinnedId]))
        {
            var pinned = sorted.Find(task => task.Id == id);

            if (pinned != null)
            {
                sorted.Remove(pinned);
                sorted.Insert(Math.Clamp(_positions[id], 0, sorted.Count), pinned);
            }
        }

        return sorted;
    }

    private List<ActiveFilter> GetActiveFilters()
    {
        var filters = new List<ActiveFilter>();

        if (_searchText.Trim().Length > 0)
        {
            filters.Add(new ActiveFilter("search", $"Søk: «{_searchText.Trim()}»"));
        }

        if (_statusValue != string.Empty)
        {
            var text = _statusValue == AllValue ? "Alle" : TaskText.StatusText(Enum.Parse<TaskItemStatus>(_statusValue));
            filters.Add(new ActiveFilter("status", $"Status: {text}"));
        }

        if (Enum.TryParse<TaskItemCategory>(_categoryValue, out var category))
        {
            filters.Add(new ActiveFilter("category", $"Kategori: {TaskText.CategoryText(category)}"));
        }

        if (Enum.TryParse<TaskItemPriority>(_priorityValue, out var priority))
        {
            filters.Add(new ActiveFilter("priority", $"Prioritet: {TaskText.PriorityText(priority)}"));
        }

        if (int.TryParse(_housingUnitValue, out var housingUnitId))
        {
            var unit = _housingUnits.FirstOrDefault(existing => existing.Id == housingUnitId);
            filters.Add(new ActiveFilter("unit", $"Boenhet: {unit?.Address ?? housingUnitId.ToString()}"));
        }

        if (int.TryParse(_boardCaseValue, out var boardCaseId))
        {
            filters.Add(new ActiveFilter("case", $"Styresak: #{boardCaseId}"));
        }

        return filters;
    }

    private void RemoveFilter(string key)
    {
        switch (key)
        {
            case "search": _searchText = string.Empty; break;
            case "status": StatusValue = string.Empty; break;
            case "category": _categoryValue = string.Empty; break;
            case "priority": _priorityValue = string.Empty; break;
            case "unit": _housingUnitValue = string.Empty; break;
            case "case": _boardCaseValue = string.Empty; break;
        }

        ClearSuccessFeedback();
    }

    private void ResetFilters()
    {
        _tab = OpenTab;
        _searchText = string.Empty;
        _statusValue = string.Empty;
        _categoryValue = string.Empty;
        _priorityValue = string.Empty;
        _housingUnitValue = string.Empty;
        _boardCaseValue = string.Empty;
        ClearSuccessFeedback();
    }

    private void ShowAll()
    {
        StatusValue = AllValue;
    }

    private string BoardCaseText(int boardCaseId)
    {
        var boardCase = _boardCases.FirstOrDefault(existing => existing.Id == boardCaseId);

        return boardCase == null ? $"Styresak #{boardCaseId}" : $"Styresak #{boardCase.Id} {boardCase.Title}";
    }

    private string HousingUnitText(int unitId)
    {
        var unit = _housingUnits.FirstOrDefault(existing => existing.Id == unitId);

        return unit == null ? $"Boenhet {unitId}" : unit.Address;
    }

    private async Task CompleteAsync(TaskItem task)
    {
        if (task.Status == TaskItemStatus.Completed)
        {
            return;
        }

        var previousStatus = task.Status;
        await ChangeStatusAsync(
            task,
            TaskItemStatus.Completed,
            $"«{task.Title}» er fullført.",
            previousStatus);
    }

    private async Task ReopenAsync(TaskItem task)
    {
        if (task.Status != TaskItemStatus.Completed)
        {
            return;
        }

        await ChangeStatusAsync(
            task,
            TaskItemStatus.InProgress,
            $"«{task.Title}» er gjenåpnet og står nå som «{TaskText.StatusText(TaskItemStatus.InProgress)}».",
            null);
    }

    private async Task UndoAsync(int id)
    {
        var task = _allTasks.FirstOrDefault(existing => existing.Id == id);

        if (task == null || !_feedback.TryGetValue(id, out var feedback) || feedback.UndoTo is not { } statusBefore
            || task.Status != TaskItemStatus.Completed)
        {
            return;
        }

        await ChangeStatusAsync(
            task,
            statusBefore,
            $"Fullføringen er angret. «{task.Title}» står igjen som «{TaskText.StatusText(statusBefore)}».",
            null);
    }

    private async Task ChangeStatusAsync(TaskItem task, TaskItemStatus newStatus, string successMessage, TaskItemStatus? undoTo)
    {
        var id = task.Id;

        if (!_busyIds.Add(id))
        {
            return;
        }

        if (!_positions.ContainsKey(id))
        {
            _positions[id] = GetVisibleTasks(TaskService.GetToday()).FindIndex(existing => existing.Id == id);
        }

        try
        {
            await TaskService.ChangeStatusAsync(id, newStatus);
            await ReloadTasksAsync();
            _feedback[id] = new RowFeedback(successMessage, FeedbackKind.Success, undoTo);
        }
        catch (KeyNotFoundException)
        {
            _feedback[id] = new RowFeedback("Oppgaven finnes ikke lenger. Last siden på nytt.", FeedbackKind.Error, null);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not change status of task {Id}.", id);
            _feedback[id] = new RowFeedback(
                $"Kunne ikke lagre endringen av «{task.Title}». Kontroller at databasen er tilgjengelig og prøv på nytt.",
                FeedbackKind.Error,
                null);
        }
        finally
        {
            _busyIds.Remove(id);
        }
    }

    private void DismissFeedback(int id)
    {
        _feedback.Remove(id);
        _positions.Remove(id);
    }

    /// <summary>Messages of earlier actions go away when the view changes. Errors stay until the person closes them.</summary>
    private void ClearSuccessFeedback()
    {
        foreach (var id in _feedback.Where(pair => pair.Value.Kind == FeedbackKind.Success).Select(pair => pair.Key).ToList())
        {
            _feedback.Remove(id);
            _positions.Remove(id);
        }
    }
}
