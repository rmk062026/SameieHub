@page "/Error"
@using System.Diagnostics

<PageTitle>Feil – SameieHub</PageTitle>

<section class="surface-card empty-state">
    <h1>Noe gikk galt</h1>
    <p>Det oppstod en feil under behandlingen av forespørselen.</p>

    @if (ShowRequestId)
    {
        <p class="text-muted">Feilreferanse: <code>@RequestId</code></p>
    }

    <a class="btn btn-primary" href="/">Til Dashboard</a>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
