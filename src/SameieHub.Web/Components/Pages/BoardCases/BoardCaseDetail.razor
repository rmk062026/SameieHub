@page "/styresaker/{Id:int}"
@inject BoardCaseService BoardCaseService
@using SameieHub.Web.Components.Pages.TaskItems
@inject HousingUnitService HousingUnitService
@inject TaskItemService TaskService
@inject NavigationManager Navigation
@inject ILogger<BoardCaseDetail> Logger

<PageTitle>@(_boardCase?.Title ?? "Styresak") – SameieHub</PageTitle>

@if (_isLoading)
{
    <PageHeader Title="Styresak" BackHref="/styresaker" BackText="Styresaker" />
    <div class="surface-card" role="status">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Laster styresak …
    </div>
}
else if (_loadError != null)
{
    <PageHeader Title="Styresak" BackHref="/styresaker" BackText="Styresaker" />
    <div class="alert alert-danger" role="alert">
        <p>@_loadError</p>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Prøv igjen</button>
    </div>
}
else if (_boardCase == null)
{
    <PageHeader Title="Styresak" BackHref="/styresaker" BackText="Styresaker" />
    <div class="surface-card empty-state">
        <h2>Fant ikke styresaken</h2>
        <p>Styresaken finnes ikke, eller den er slettet.</p>
        <a class="btn btn-primary" href="/styresaker">Tilbake til styresaker</a>
    </div>
}
else
{
    var today = TaskService.GetToday();
    var completedTasks = _linkedTasks.Count(task => task.Status == TaskItemStatus.Completed);

    <PageHeader Title="@_boardCase.Title" BackHref="/styresaker" BackText="Styresaker" MoreActionsKey="_menuVersion">
        <ChildContent><a class="btn btn-outline-secondary" href="/styresaker/@_boardCase.Id/rediger">Rediger</a></ChildContent>
        <PrimaryAction>
            @switch (NextStep)
            {
                case NextStepKind.Start:
                    <button type="button" class="btn btn-primary" data-testid="main-action" disabled="@_isBusy" @onclick="StartAsync">Start behandling</button>
                    break;
                case NextStepKind.RegisterDecision:
                    <button type="button" class="btn btn-primary" data-testid="main-action" disabled="@(_isBusy || _editingDecision)" @onclick="OpenDecisionForm">Registrer vedtak</button>
                    break;
                case NextStepKind.MarkDecided:
                    <button type="button" class="btn btn-primary" data-testid="main-action" disabled="@_isBusy" @onclick="MarkDecidedAsync">Marker som vedtatt</button>
                    break;
                case NextStepKind.Close:
                    <button type="button" class="btn btn-primary" data-testid="main-action" disabled="@_isBusy" @onclick="CloseAsync">Avslutt saken</button>
                    break;
                default:
                    <button type="button" class="btn btn-primary" data-testid="main-action" disabled="@_isBusy" @onclick="ReopenAsync">Gjenåpne saken</button>
                    break;
            }
        </PrimaryAction>
        <MoreActions>
            @foreach (var status in BoardCaseText.AllStatuses.Where(status => status != _boardCase.Status))
            {
                var newStatus = status;
                <button type="button" data-testid="set-status-@newStatus" disabled="@_isBusy" @onclick="() => SetStatusAsync(newStatus)">Sett status til «@BoardCaseText.StatusText(newStatus)»</button>
            }
        </MoreActions>
    </PageHeader>

    @if (_feedbackArea == FeedbackArea.Header)
    {
        <ActionFeedback Message="@_message" OnDismiss="DismissFeedback" />
        <ActionFeedback Message="@_actionError" Kind="FeedbackKind.Error" OnDismiss="DismissFeedback" />
    }

    <section class="surface-card task-summary" aria-label="Om saken" data-testid="case-summary">
        <dl class="detail-list">
            <div class="detail-item">
                <dt>Status</dt>
                <dd>
                    <BoardCaseStatusBadge Status="_boardCase.Status" />
                    @if (_boardCase.Priority == BoardCasePriority.High)
                    {
                        <span class="status-badge priority-high ms-1" data-testid="high-priority">Høy prioritet</span>
                    }
                </dd>
            </div>
            <DetailItem Label="Registrert møtedato" Value="@(_boardCase.MeetingDate is { } meetingDate ? NorwegianDateFormat.Date(meetingDate) : null)" />
            <div class="detail-item">
                <dt>Gjelder</dt>
                <dd data-testid="case-housing-unit">
                    @if (_boardCase.HousingUnitId == null)
                    {
                        <span>Hele sameiet</span>
                    }
                    else if (_housingUnit == null)
                    {
                        <span>Boenhet @_boardCase.HousingUnitId</span>
                    }
                    else
                    {
                        <a href="/boenheter/@_housingUnit.Id">@_housingUnit.Address</a>
                        @if (!_housingUnit.IsActive)
                        {
                            <span class="text-muted"> (inaktiv)</span>
                        }
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="surface-card" aria-labelledby="description-title" data-testid="case-description">
        <h2 id="description-title">Beskrivelse</h2>
        @if (string.IsNullOrWhiteSpace(_boardCase.Description))
        {
            <p class="text-muted mb-0">Ikke registrert</p>
        }
        else
        {
            <p class="notes-text mb-0">@_boardCase.Description</p>
        }
    </section>

    <section class="surface-card" aria-labelledby="decision-title" data-testid="decision-section">
        <div class="section-heading">
            <h2 id="decision-title">Vedtak</h2>
            @if (!_editingDecision && !ShowsDecisionAsMainAction)
            {
                <button type="button" class="btn btn-outline-primary btn-sm" data-testid="open-decision-form" disabled="@_isBusy" @onclick="OpenDecisionForm">
                    @(_boardCase.Decision == null ? "Registrer vedtak" : "Endre vedtak")
                </button>
            }
        </div>

        @if (_feedbackArea == FeedbackArea.Decision)
        {
            <ActionFeedback Message="@_message" OnDismiss="DismissFeedback" />
            <ActionFeedback Message="@_actionError" Kind="FeedbackKind.Error" OnDismiss="DismissFeedback" />
        }

        @if (_boardCase.Decision != null)
        {
            <div class="decision-box" data-testid="decision-box">
                <p class="notes-text mb-2">@_boardCase.Decision</p>
                <p class="decision-date mb-0">
                    Vedtaksdato:
                    @if (_boardCase.DecisionDate is { } decisionDate)
                    {
                        <strong>@NorwegianDateFormat.Date(decisionDate)</strong>
                    }
                    else
                    {
                        <span class="text-muted">Ikke registrert</span>
                    }
                </p>
            </div>
        }
        else if (!_editingDecision)
        {
            <p class="text-muted mb-0" data-testid="no-decision">
                Ingen vedtak er registrert ennå. En sak kan bare settes til «Vedtatt» når et vedtak er registrert.
            </p>
        }

        @if (_editingDecision)
        {
            <div class="mt-3" data-testid="decision-form">
                <label for="decision" class="form-label">@(_boardCase.Decision == null ? "Vedtak" : "Vedtak (endrer det som er registrert)")</label>
                <textarea id="decision" class="form-control" rows="4" maxlength="@BoardCase.MaxDecisionLength" @ref="_decisionInput"
                          @bind="_decisionText" @bind:event="oninput"></textarea>

                <label for="decisionDate" class="form-label mt-3">Vedtaksdato</label>
                <input id="decisionDate" type="date" class="form-control date-input" @bind="_decisionDate"
                       aria-describedby="decisionDate-help" />
                <div id="decisionDate-help" class="form-text">Datoen styret fattet vedtaket. Kan stå tom.</div>

                <div class="form-actions mt-3">
                    <button type="button" class="btn btn-primary" disabled="@_isBusy" @onclick="SaveDecisionAsync">
                        @(_boardCase.Decision == null ? "Registrer vedtak" : "Lagre vedtak")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="CancelDecisionForm">Avbryt</button>
                    @if (_boardCase.Decision != null)
                    {
                        <button type="button" class="btn btn-outline-danger" disabled="@_isBusy" @onclick="ClearDecisionAsync">Fjern vedtak</button>
                    }
                </div>
            </div>
        }
    </section>

    <section class="surface-card" aria-labelledby="tasks-title" data-testid="case-tasks">
        <div class="section-heading">
            <h2 id="tasks-title">
                Oppgaver til saken
                @if (_linkedTasks.Count > 0)
                {
                    <span class="text-muted fs-6 fw-normal" data-testid="task-progress">(@completedTasks av @_linkedTasks.Count fullført)</span>
                }
            </h2>
            <a class="btn btn-outline-primary btn-sm" data-testid="new-task" href="/oppgaver/ny?styresak=@_boardCase.Id">Ny oppgave</a>
        </div>
        @if (_linkedTasks.Count == 0)
        {
            <p class="text-muted mb-0">Ingen oppgaver er knyttet til denne saken ennå. En oppgave er noe noen skal gjøre, for eksempel for å følge opp et vedtak.</p>
        }
        else
        {
            <ul class="follow-up-list">
                @foreach (var task in _linkedTasks)
                {
                    <li data-testid="case-task">
                        <a class="unit-link" href="/oppgaver/@task.Id">@task.Title</a>
                        <span class="follow-up-meta">
                            <span data-testid="case-task-assignee">@(string.IsNullOrWhiteSpace(task.AssignedTo) ? "Ikke tildelt" : task.AssignedTo)</span>
                            <span class="follow-up-due"><TaskDueDate Task="task" Today="today" /></span>
                            <TaskStatusBadge Status="task.Status" />
                        </span>
                    </li>
                }
            </ul>
            @if (completedTasks == _linkedTasks.Count && _boardCase.Status != BoardCaseStatus.Closed)
            {
                <p class="text-muted small mt-2 mb-0" data-testid="close-hint">Alle oppgavene er fullført. Vurder om saken kan avsluttes.</p>
            }
        }
    </section>

    <Disclosure Label="Detaljer" Hint="Saksnummer · Prioritet · Merknader · Opprettet · Sist oppdatert">
        <dl class="detail-list">
            <DetailItem Label="Saksnummer" Value="@($"#{_boardCase.Id}")" />
            <DetailItem Label="Prioritet" Value="@BoardCaseText.PriorityText(_boardCase.Priority)" />
            <DetailItem Label="Merknader" Value="@_boardCase.Notes" />
            <DetailItem Label="Opprettet" Value="@NorwegianDateFormat.DateTime(_boardCase.CreatedAt)" />
            <DetailItem Label="Sist oppdatert" Value="@NorwegianDateFormat.DateTime(_boardCase.UpdatedAt)" />
        </dl>
    </Disclosure>

    <section class="surface-card danger-zone">
        @if (_deleteError != null)
        {
            <div class="alert alert-danger" role="alert">@_deleteError</div>
        }

        @if (!_confirmingDelete)
        {
            <div class="danger-zone-row">
                <div>
                    <h2>Slett styresak</h2>
                    <p class="text-muted mb-0">Fjerner saken og vedtaket permanent. Bruk dette bare for feilregistrerte saker.</p>
                </div>
                <button type="button" class="btn btn-outline-danger" @onclick="AskForDeleteConfirmation">Slett styresaken …</button>
            </div>
        }
        else
        {
            <div role="alertdialog" aria-labelledby="delete-title" aria-describedby="delete-text">
                <h2 id="delete-title">Slette «@_boardCase.Title» permanent?</h2>
                <p id="delete-text">
                    <strong>Dette kan ikke angres.</strong> Styresaken og alle opplysninger om den, også vedtaket, blir slettet for alltid.
                    Saker som er knyttet til oppgaver kan ikke slettes.
                </p>
                <div class="form-actions">
                    <button type="button" class="btn btn-danger" disabled="@_isDeleting" @onclick="DeleteAsync">
                        @(_isDeleting ? "Sletter …" : "Ja, slett permanent")
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@_isDeleting" @onclick="CancelDelete">Avbryt</button>
                </div>
            </div>
        }
    </section>
}

@code {
    private enum NextStepKind { Start, RegisterDecision, MarkDecided, Close, Reopen }

    private enum FeedbackArea { Header, Decision }

    private BoardCase? _boardCase;
    private HousingUnit? _housingUnit;
    private IReadOnlyList<TaskItem> _linkedTasks = [];
    private string _decisionText = string.Empty;
    private DateOnly? _decisionDate;
    private ElementReference _decisionInput;
    private bool _focusDecisionInput;
    private bool _editingDecision;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _confirmingDelete;
    private bool _isDeleting;
    private int _menuVersion;
    private FeedbackArea _feedbackArea = FeedbackArea.Header;
    private string? _loadError;
    private string? _message;
    private string? _actionError;
    private string? _deleteError;

    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    /// <summary>The most natural next step for the case, shown as the one main button of the page.</summary>
    private NextStepKind NextStep => _boardCase!.Status switch
    {
        BoardCaseStatus.New => NextStepKind.Start,
        BoardCaseStatus.InProgress => _boardCase.Decision == null ? NextStepKind.RegisterDecision : NextStepKind.MarkDecided,
        BoardCaseStatus.Decided => NextStepKind.Close,
        _ => NextStepKind.Reopen
    };

    /// <summary>The page already offers «Registrer vedtak» as its main button, so the heading of the decision section does not repeat it.</summary>
    private bool ShowsDecisionAsMainAction => NextStep == NextStepKind.RegisterDecision;

    protected override async Task OnParametersSetAsync()
    {
        _message = Status switch
        {
            "opprettet" => "Styresaken er registrert.",
            "endret" => "Endringene er lagret.",
            _ => null
        };
        _feedbackArea = FeedbackArea.Header;

        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDecisionInput)
        {
            _focusDecisionInput = false;
            await _decisionInput.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            await ReadCaseAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load board case {Id}.", Id);
            _loadError = "Kunne ikke hente styresaken. Kontroller at databasen er tilgjengelig og prøv igjen.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReadCaseAsync()
    {
        _boardCase = await BoardCaseService.GetByIdAsync(Id);
        _housingUnit = _boardCase?.HousingUnitId == null
            ? null
            : await HousingUnitService.GetByIdAsync(_boardCase.HousingUnitId.Value);

        var allTasks = await TaskService.GetAllAsync();
        _linkedTasks = TaskItemSorting.Sort(allTasks.Where(task => task.BoardCaseId == Id), TaskItemSortOrder.DueDate);

        if (_boardCase != null)
        {
            _decisionText = _boardCase.Decision ?? string.Empty;
            _decisionDate = _boardCase.DecisionDate;
        }
    }

    private async Task StartAsync()
    {
        await ChangeStatusAsync(BoardCaseStatus.InProgress, $"Saken er satt til «{BoardCaseText.StatusText(BoardCaseStatus.InProgress)}».");
    }

    private async Task MarkDecidedAsync()
    {
        await ChangeStatusAsync(BoardCaseStatus.Decided, "Saken er markert som vedtatt.");
    }

    private async Task CloseAsync()
    {
        await ChangeStatusAsync(BoardCaseStatus.Closed, "Saken er avsluttet.");
    }

    private async Task ReopenAsync()
    {
        await ChangeStatusAsync(BoardCaseStatus.InProgress, $"Saken er gjenåpnet og står nå som «{BoardCaseText.StatusText(BoardCaseStatus.InProgress)}».");
    }

    private async Task SetStatusAsync(BoardCaseStatus newStatus)
    {
        await ChangeStatusAsync(newStatus, $"Statusen er endret til «{BoardCaseText.StatusText(newStatus)}».");
    }

    private async Task ChangeStatusAsync(BoardCaseStatus newStatus, string successMessage)
    {
        await RunActionAsync(
            FeedbackArea.Header,
            () => BoardCaseService.ChangeStatusAsync(Id, newStatus),
            successMessage,
            _ => "Saken kan ikke settes til «Vedtatt» før et vedtak er registrert.");
    }

    private void OpenDecisionForm()
    {
        _editingDecision = true;
        _focusDecisionInput = true;
        _message = null;
        _actionError = null;
    }

    private void CancelDecisionForm()
    {
        _editingDecision = false;
        _decisionText = _boardCase!.Decision ?? string.Empty;
        _decisionDate = _boardCase.DecisionDate;
        _actionError = null;
    }

    private async Task SaveDecisionAsync()
    {
        await RunActionAsync(
            FeedbackArea.Decision,
            () => BoardCaseService.RegisterDecisionAsync(Id, _decisionText, _decisionDate),
            "Vedtaket er lagret.",
            DecisionRejectedMessage);
    }

    private async Task ClearDecisionAsync()
    {
        await RunActionAsync(
            FeedbackArea.Decision,
            () => BoardCaseService.ClearDecisionAsync(Id),
            "Vedtaket og vedtaksdatoen er fjernet.",
            _ => "Et vedtak kan ikke fjernes mens saken har status «Vedtatt». Endre statusen først.");
    }

    private static string DecisionRejectedMessage(Exception exception)
    {
        if (exception is ArgumentException { ParamName: "DecisionDate" })
        {
            var from = NorwegianDateFormat.Date(BoardCase.MinDecisionDate);
            var to = NorwegianDateFormat.Date(BoardCase.MaxDecisionDate);

            return $"Vedtaksdatoen må være mellom {from} og {to}.";
        }

        return $"Vedtaket må fylles ut og kan ha maks {BoardCase.MaxDecisionLength} tegn.";
    }

    private void DismissFeedback()
    {
        _message = null;
        _actionError = null;
    }

    private async Task RunActionAsync(FeedbackArea area, Func<Task> action, string successMessage, Func<Exception, string> rejectedMessage)
    {
        if (_isBusy)
        {
            return;
        }

        _isBusy = true;
        _message = null;
        _actionError = null;
        _feedbackArea = area;

        try
        {
            await action();
            await ReadCaseAsync();
            _message = successMessage;
            _menuVersion++;

            if (area == FeedbackArea.Decision)
            {
                _editingDecision = false;
            }
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidOperationException)
        {
            _actionError = rejectedMessage(exception);
        }
        catch (KeyNotFoundException)
        {
            _actionError = "Styresaken finnes ikke lenger. Gå tilbake til oversikten.";
        }
        catch (Exception exception)
        {
            // The decision text is never logged because it can contain personal data.
            Logger.LogError(exception, "Could not change board case {Id}.", Id);
            _actionError = "Kunne ikke lagre endringen. Kontroller at databasen er tilgjengelig og prøv på nytt.";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void AskForDeleteConfirmation()
    {
        _deleteError = null;
        _confirmingDelete = true;
    }

    private void CancelDelete()
    {
        _confirmingDelete = false;
    }

    private async Task DeleteAsync()
    {
        if (_isDeleting)
        {
            return;
        }

        _isDeleting = true;
        _deleteError = null;

        try
        {
            await BoardCaseService.DeleteAsync(Id);

            Navigation.NavigateTo("/styresaker?status=slettet");
        }
        catch (BoardCaseInUseException)
        {
            _deleteError = "Styresaken kan ikke slettes fordi den er knyttet til oppgaver. Fjern koblingene først.";
            _confirmingDelete = false;
        }
        catch (KeyNotFoundException)
        {
            _deleteError = "Styresaken finnes ikke lenger. Gå tilbake til oversikten.";
            _confirmingDelete = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not delete board case {Id}.", Id);
            _deleteError = "Kunne ikke slette styresaken. Kontroller at databasen er tilgjengelig og prøv på nytt.";
            _confirmingDelete = false;
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
