@page "/styresaker"
@inject BoardCaseService BoardCaseService
@inject HousingUnitService HousingUnitService
@inject TaskItemService TaskService
@inject ILogger<BoardCaseList> Logger

<PageTitle>Styresaker – SameieHub</PageTitle>

<PageHeader Title="Styresaker" Description="Saker som styret skal behandle og eventuelt vedta.">
    <PrimaryAction><a class="btn btn-primary" href="/styresaker/ny">Ny styresak</a></PrimaryAction>
</PageHeader>

@if (StatusMessage != null)
{
    <div class="alert alert-success" role="status">@StatusMessage</div>
}

@if (_isLoading)
{
    <div class="surface-card" role="status">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Laster styresaker …
    </div>
}
else if (_loadError != null)
{
    <div class="alert alert-danger" role="alert">
        <p>@_loadError</p>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Prøv igjen</button>
    </div>
}
else if (_allCases.Count == 0)
{
    <section class="surface-card empty-state" data-testid="no-cases">
        <h2>Ingen styresaker registrert ennå</h2>
        <p>Registrer den første styresaken for å komme i gang.</p>
        <a class="btn btn-primary" href="/styresaker/ny">Ny styresak</a>
    </section>
}
else
{
    var visibleCases = GetVisibleCases();

    <QuickTabs AriaLabel="Vis styresaker" Tabs="GetTabs()" Selected="@_tab" SelectedChanged="ChooseTab" />
    <p class="text-muted small" data-testid="tab-explanation">Åpne er alle saker som ikke er avsluttet, også de som er vedtatt.</p>

    <div class="list-search">
        <label for="case-search" class="visually-hidden">Søk i styresaker</label>
        <input id="case-search" type="search" class="form-control" data-testid="case-search"
               placeholder="Søk i tittel, beskrivelse eller saksnummer"
               @bind="_searchText" @bind:event="oninput" />
    </div>

    <Disclosure Label="Flere filtre" Hint="Status · Prioritet · Boenhet · Sortering">
        <div class="filter-grid">
            <div>
                <label for="filter-status" class="form-label">Status</label>
                <select id="filter-status" class="form-select" @bind="StatusValue">
                    <option value="">Følger valgt visning</option>
                    @foreach (var status in BoardCaseText.AllStatuses)
                    {
                        <option value="@status">@BoardCaseText.StatusText(status)</option>
                    }
                    <option value="@AllValue">Alle (også avsluttede)</option>
                </select>
            </div>
            <div>
                <label for="filter-priority" class="form-label">Prioritet</label>
                <select id="filter-priority" class="form-select" @bind="_priorityValue">
                    <option value="">Alle prioriteter</option>
                    @foreach (var priority in BoardCaseText.AllPriorities)
                    {
                        <option value="@priority">@BoardCaseText.PriorityText(priority)</option>
                    }
                </select>
            </div>
            <div>
                <label for="filter-unit" class="form-label">Boenhet</label>
                <select id="filter-unit" class="form-select" @bind="_housingUnitValue">
                    <option value="">Alle boenheter</option>
                    <option value="@WholeCooperativeValue">Hele sameiet (ingen boenhet)</option>
                    @foreach (var unit in _housingUnits)
                    {
                        <option value="@unit.Id">@unit.Address@(unit.IsActive ? "" : " (inaktiv)")</option>
                    }
                </select>
            </div>
            <div>
                <label for="filter-sort" class="form-label">Sortering</label>
                <select id="filter-sort" class="form-select" @bind="SortOrder">
                    @foreach (var order in Enum.GetValues<BoardCaseSortOrder>())
                    {
                        <option value="@order">@BoardCaseText.SortOrderText(order)</option>
                    }
                </select>
            </div>
        </div>
    </Disclosure>

    <ActiveFilters Filters="GetActiveFilters()" OnRemove="RemoveFilter" OnClearAll="ResetFilters" />

    @if (visibleCases.Count == 0)
    {
        <section class="surface-card empty-state" data-testid="empty-list">
            <h2>Ingen styresaker funnet</h2>
            <p>Sameiet har @_allCases.Count @(_allCases.Count == 1 ? "styresak" : "styresaker") i alt, men ingen passer med valgt visning, søk og filtre.</p>
            <button type="button" class="btn btn-outline-primary" @onclick="ResetFilters">Nullstill søk og filtre</button>
            @if (_tab == OpenTab && !HasExtraFilters)
            {
                <button type="button" class="btn btn-link" @onclick="ShowAll">Vis også avsluttede</button>
            }
        </section>
    }
    else
    {
        <p class="summary" role="status" data-testid="list-summary">Viser <strong>@visibleCases.Count</strong> av @_allCases.Count @(_allCases.Count == 1 ? "styresak" : "styresaker")</p>

        <div class="data-table-card">
            <table class="table data-table table-cards" data-testid="case-table">
                <caption class="visually-hidden">Styresaker</caption>
                <thead>
                    <tr>
                        <th scope="col">Sak</th>
                        <th scope="col">Møtedato</th>
                        <th scope="col">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var boardCase in visibleCases)
                    {
                        <tr data-testid="case-row" data-case-id="@boardCase.Id">
                            <td data-label="Sak">
                                <div>
                                    <a class="unit-link" data-testid="case-title" href="/styresaker/@boardCase.Id">@boardCase.Title</a>
                                    @if (boardCase.Priority == BoardCasePriority.High)
                                    {
                                        <span class="status-badge priority-high ms-1" data-testid="high-priority">Høy prioritet</span>
                                    }
                                    <div class="unit-sub" data-testid="case-scope">
                                        @if (boardCase.HousingUnitId is { } unitId)
                                        {
                                            <a href="/boenheter/@unitId">@HousingUnitText(unitId)</a>
                                        }
                                        else
                                        {
                                            <span>Hele sameiet</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td data-label="Møtedato" data-testid="case-meeting-date">
                                @if (boardCase.MeetingDate is { } meetingDate)
                                {
                                    @NorwegianDateFormat.Date(meetingDate)
                                }
                                else
                                {
                                    <span class="text-muted">Ingen møtedato</span>
                                }
                            </td>
                            <td data-label="Status"><BoardCaseStatusBadge Status="boardCase.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private const string OpenTab = "open";
    private const string DecidedTab = "decided";
    private const string ClosedTab = "closed";
    private const string AllValue = "all";
    private const string WholeCooperativeValue = "none";

    private IReadOnlyList<BoardCase> _allCases = [];
    private IReadOnlyList<HousingUnit> _housingUnits = [];
    private string _tab = OpenTab;
    private string _searchText = string.Empty;
    private string _statusValue = string.Empty;
    private string _priorityValue = string.Empty;
    private string _housingUnitValue = string.Empty;
    private BoardCaseSortOrder? _chosenSortOrder;
    private bool _isLoading = true;
    private string? _loadError;

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    private string? StatusMessage => Status == "slettet" ? "Styresaken er slettet permanent." : null;

    /// <summary>Choosing a specific status replaces the quick choice, so the two can never contradict each other.</summary>
    private string StatusValue
    {
        get => _statusValue;
        set
        {
            _statusValue = value;
            _tab = value == string.Empty ? OpenTab : string.Empty;
        }
    }

    /// <summary>Open cases are shown by meeting date, the nearest first. Other views show the most recently updated case first.</summary>
    private BoardCaseSortOrder SortOrder
    {
        get => _chosenSortOrder ?? (_tab == OpenTab ? BoardCaseSortOrder.MeetingDate : BoardCaseSortOrder.RecentlyUpdated);
        set => _chosenSortOrder = value;
    }

    private bool HasExtraFilters =>
        _searchText.Trim().Length > 0 || _priorityValue != string.Empty || _housingUnitValue != string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            _allCases = await BoardCaseService.GetAllAsync();

            var units = await HousingUnitService.GetAllAsync();
            _housingUnits = units.OrderBy(unit => unit.Address).ToList();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load board cases.");
            _loadError = "Kunne ikke hente styresakene. Kontroller at databasen er tilgjengelig og prøv igjen.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<QuickTab> GetTabs()
    {
        return
        [
            new QuickTab(OpenTab, "Åpne", _allCases.Count(boardCase => boardCase.Status != BoardCaseStatus.Closed)),
            new QuickTab(DecidedTab, "Vedtatt", _allCases.Count(boardCase => boardCase.Status == BoardCaseStatus.Decided)),
            new QuickTab(ClosedTab, "Avsluttet", _allCases.Count(boardCase => boardCase.Status == BoardCaseStatus.Closed))
        ];
    }

    private void ChooseTab(string key)
    {
        _tab = key;
        _statusValue = string.Empty;
    }

    private List<BoardCase> GetVisibleCases()
    {
        var criteria = new BoardCaseFilterCriteria
        {
            SearchText = _searchText,
            Status = _tab switch
            {
                DecidedTab => BoardCaseStatus.Decided,
                ClosedTab => BoardCaseStatus.Closed,
                _ => Enum.TryParse<BoardCaseStatus>(_statusValue, out var status) ? status : null
            },
            Priority = Enum.TryParse<BoardCasePriority>(_priorityValue, out var priority) ? priority : null,
            HousingUnitId = int.TryParse(_housingUnitValue, out var housingUnitId) ? housingUnitId : null,
            WholeCooperativeOnly = _housingUnitValue == WholeCooperativeValue
        };

        var cases = BoardCaseFilter.Apply(_allCases, criteria);

        if (_tab == OpenTab)
        {
            cases = cases.Where(boardCase => boardCase.Status != BoardCaseStatus.Closed).ToList();
        }

        var sorted = BoardCaseSorting.Sort(cases, SortOrder);

        return _chosenSortOrder == null && _tab == OpenTab ? PutUpcomingMeetingsFirst(sorted) : sorted;
    }

    /// <summary>
    /// The default view of open cases: cases with a meeting date today or later first (nearest first), then cases without a date, then
    /// cases whose registered date has passed (most recent first). Nothing is hidden. It only keeps old dates from filling the top.
    /// </summary>
    private List<BoardCase> PutUpcomingMeetingsFirst(List<BoardCase> casesByMeetingDate)
    {
        var today = TaskService.GetToday();
        var upcoming = new List<BoardCase>();
        var withoutDate = new List<BoardCase>();
        var passed = new List<BoardCase>();

        foreach (var boardCase in casesByMeetingDate)
        {
            if (boardCase.MeetingDate is not { } meetingDate)
            {
                withoutDate.Add(boardCase);
            }
            else if (meetingDate >= today)
            {
                upcoming.Add(boardCase);
            }
            else
            {
                passed.Add(boardCase);
            }
        }

        passed.Reverse();

        return [.. upcoming, .. withoutDate, .. passed];
    }

    private List<ActiveFilter> GetActiveFilters()
    {
        var filters = new List<ActiveFilter>();

        if (_searchText.Trim().Length > 0)
        {
            filters.Add(new ActiveFilter("search", $"Søk: «{_searchText.Trim()}»"));
        }

        if (_statusValue != string.Empty)
        {
            var text = _statusValue == AllValue ? "Alle" : BoardCaseText.StatusText(Enum.Parse<BoardCaseStatus>(_statusValue));
            filters.Add(new ActiveFilter("status", $"Status: {text}"));
        }

        if (Enum.TryParse<BoardCasePriority>(_priorityValue, out var priority))
        {
            filters.Add(new ActiveFilter("priority", $"Prioritet: {BoardCaseText.PriorityText(priority)}"));
        }

        if (_housingUnitValue == WholeCooperativeValue)
        {
            filters.Add(new ActiveFilter("unit", "Boenhet: Hele sameiet"));
        }
        else if (int.TryParse(_housingUnitValue, out var housingUnitId))
        {
            filters.Add(new ActiveFilter("unit", $"Boenhet: {HousingUnitText(housingUnitId)}"));
        }

        return filters;
    }

    private void RemoveFilter(string key)
    {
        switch (key)
        {
            case "search": _searchText = string.Empty; break;
            case "status": StatusValue = string.Empty; break;
            case "priority": _priorityValue = string.Empty; break;
            case "unit": _housingUnitValue = string.Empty; break;
        }
    }

    private void ResetFilters()
    {
        _tab = OpenTab;
        _searchText = string.Empty;
        _statusValue = string.Empty;
        _priorityValue = string.Empty;
        _housingUnitValue = string.Empty;
    }

    private void ShowAll()
    {
        StatusValue = AllValue;
    }

    private string HousingUnitText(int unitId)
    {
        var unit = _housingUnits.FirstOrDefault(existing => existing.Id == unitId);

        return unit == null ? $"Boenhet {unitId}" : unit.Address;
    }
}
