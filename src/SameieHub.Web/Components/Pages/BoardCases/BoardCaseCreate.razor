@page "/styresaker/ny"
@inject BoardCaseService BoardCaseService
@inject HousingUnitService HousingUnitService
@inject NavigationManager Navigation
@inject ILogger<BoardCaseCreate> Logger

<PageTitle>Ny styresak – SameieHub</PageTitle>

<PageHeader Title="Ny styresak" Description="Bare tittelen er obligatorisk. Resten kan du fylle inn senere."
            BackHref="/styresaker" BackText="Styresaker" />

@if (_isLoading)
{
    <div class="surface-card" role="status">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Laster skjema …
    </div>
}
else if (_loadError != null)
{
    <div class="alert alert-danger" role="alert">
        <p>@_loadError</p>
        <button type="button" class="btn btn-outline-danger btn-sm" @onclick="LoadAsync">Prøv igjen</button>
    </div>
}
else
{
    @if (_preselectNotice != null)
    {
        <div class="alert alert-warning" role="status">@_preselectNotice</div>
    }

    <p class="form-intro" data-testid="case-explanation">
        En styresak er noe styret skal behandle eller avgjøre. Hvis det bare er noe som skal gjøres av noen, kan du <a href="/oppgaver/ny">opprette en oppgave</a> i stedet.
    </p>

    <BoardCaseForm AvailableHousingUnits="_activeHousingUnits" InitialHousingUnitId="_preselectedHousingUnitId"
                   SubmitText="Lagre" OnSave="RegisterAsync" />
}

@code {
    private IReadOnlyList<HousingUnit> _activeHousingUnits = [];
    private int? _preselectedHousingUnitId;
    private string? _preselectNotice;
    private bool _isLoading = true;
    private string? _loadError;

    /// <summary>Set by the shortcut on the housing unit page. It is only a suggestion and is checked below.</summary>
    [SupplyParameterFromQuery(Name = "boenhet")]
    public int? HousingUnitId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            var units = await HousingUnitService.GetAllAsync();

            _activeHousingUnits = units.Where(unit => unit.IsActive).OrderBy(unit => unit.Address).ToList();

            PreselectHousingUnit();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load housing units for the board case form.");
            _loadError = "Kunne ikke hente boenhetene. Kontroller at databasen er tilgjengelig og prøv igjen.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void PreselectHousingUnit()
    {
        _preselectedHousingUnitId = null;
        _preselectNotice = null;

        if (HousingUnitId == null)
        {
            return;
        }

        var unit = _activeHousingUnits.FirstOrDefault(activeUnit => activeUnit.Id == HousingUnitId);
        if (unit == null)
        {
            _preselectNotice = "Boenheten fra lenken finnes ikke eller er inaktiv, så den er ikke valgt. "
                + "Velg en aktiv boenhet, eller la saken gjelde hele sameiet.";
        }
        else
        {
            _preselectedHousingUnitId = unit.Id;
        }
    }

    private async Task RegisterAsync(BoardCaseDetails details)
    {
        var boardCase = await BoardCaseService.RegisterAsync(details);

        Navigation.NavigateTo($"/styresaker/{boardCase.Id}?status=opprettet");
    }
}
