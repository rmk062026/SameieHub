<header class="page-header">
    <div>
        @if (BackHref != null)
        {
            <a class="back-link" href="@BackHref">← @BackText</a>
        }
        <h1 data-testid="page-title">@Title</h1>
        @if (Description != null)
        {
            <p>@Description</p>
        }
    </div>

    @if (ChildContent != null || MoreActions != null || PrimaryAction != null)
    {
        <div class="page-actions" data-testid="page-actions">
            @ChildContent
            @if (MoreActions != null)
            {
                <MoreMenu @key="MoreActionsKey">@MoreActions</MoreMenu>
            }
            @if (PrimaryAction != null)
            {
                <span class="page-primary-action" data-testid="primary-action">@PrimaryAction</span>
            }
        </div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? BackHref { get; set; }

    [Parameter]
    public string BackText { get; set; } = "Tilbake";

    /// <summary>The actions of the page as they were before the redesign. New pages use <see cref="PrimaryAction"/> and <see cref="MoreActions"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The one filled button of the page, on the right.</summary>
    [Parameter]
    public RenderFragment? PrimaryAction { get; set; }

    /// <summary>Rarely used actions, shown behind «Flere handlinger».</summary>
    [Parameter]
    public RenderFragment? MoreActions { get; set; }

    /// <summary>Changing this value closes «Flere handlinger» (for example after one of them has been used).</summary>
    [Parameter]
    public object? MoreActionsKey { get; set; }
}
