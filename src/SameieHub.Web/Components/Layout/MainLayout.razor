@using SameieHub.Web.Hosting
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject ShutdownService Shutdown

@if (Shutdown.IsRequested)
{
    <ShutdownNotice />
}
else
{
<a class="skip-link" href="@SkipHref" @onclick="FocusContentAsync" @onclick:preventDefault>Hopp til innhold</a>

<div class="app-shell">
    <NavMenu />

    <main @ref="_content" id="main-content" class="app-main" tabindex="-1">
        <div class="app-content">
            @Body
        </div>
    </main>
</div>
}

<div id="blazor-error-ui" data-nosnippet>
    Det oppstod en uventet feil.
    <a href="." class="reload">Last siden på nytt</a>
    <span class="dismiss" role="button" aria-label="Lukk">🗙</span>
</div>

@code {
    private ElementReference _content;

    protected override void OnInitialized()
    {
        Shutdown.Requested += OnShutdownRequested;
    }

    // Every open page shows the message, not only the one where the button was pressed.
    private void OnShutdownRequested()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Shutdown.Requested -= OnShutdownRequested;
    }

    /// <summary>
    /// The address of the current page with the fragment. A plain "#main-content" would be read against the base address of the
    /// application and take the person to the front page.
    /// </summary>
    private string SkipHref => Navigation.Uri.Split('#')[0] + "#main-content";

    /// <summary>Moves the focus to the content, so the next Tab goes to the first thing in the page and not back to the menu.</summary>
    private async Task FocusContentAsync()
    {
        await _content.FocusAsync();
    }
}
