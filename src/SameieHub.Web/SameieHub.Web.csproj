<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <AssemblyName>SameieHub</AssemblyName>
    <RootNamespace>SameieHub.Web</RootNamespace>
  </PropertyGroup>

  <!-- Only a self-contained build is the Windows program. It then starts in Windows mode without any flag (see WindowsHost). -->
  <ItemGroup Condition="'$(SelfContained)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SameieHub.DefaultHostMode</_Parameter1>
      <_Parameter2>Windows</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SameieHub.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SameieHub.Domain\SameieHub.Domain.csproj" />
    <ProjectReference Include="..\SameieHub.Infrastructure\SameieHub.Infrastructure.csproj" />
  </ItemGroup>

</Project>
